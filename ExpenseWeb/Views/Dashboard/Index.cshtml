@model ExpenseWeb.Models.ViewModels.Dashboard.DashboardIndexViewModel
@using System.IO
@using System.Linq
@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    var currencyOptions = new[]
    {
        new { Code = "VND", NameVi = "Việt Nam Đồng", NameEn = "Vietnamese Dong" },
        new { Code = "USD", NameVi = "Đô la Mỹ", NameEn = "US Dollar" },
        new { Code = "EUR", NameVi = "Euro", NameEn = "Euro" },
        new { Code = "JPY", NameVi = "Yên Nhật", NameEn = "Japanese Yen" },
        new { Code = "KRW", NameVi = "Won Hàn", NameEn = "Korean Won" }
    };

    var trendLabels = JsonSerializer.Serialize(Model.MonthlyTrend.Select(x => x.Label));
    var trendIncome = JsonSerializer.Serialize(Model.MonthlyTrend.Select(x => x.Income));
    var trendExpense = JsonSerializer.Serialize(Model.MonthlyTrend.Select(x => x.Expense));
    var donutLabels = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.CategoryName));
    var donutSeries = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.TotalAmount));
    var donutColors = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.Color));
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/wallet-dashboard.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/report-page.css" />
    <style>
        .budget-progress-bar{height:8px;background:#eceef1;border-radius:999px;overflow:hidden}
        .budget-progress-fill{height:100%}
        .dashboard-export-links a{margin-right:8px;margin-bottom:8px}
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-4">
        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="mb-1">@T("Danh sách ví", "Wallet List")</h5>
                <p class="card-subtitle mb-0">@T("Quản lý các ví và xem tổng quan số dư hiện tại.", "Manage wallets and view current balances.")</p>
            </div>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addWalletModal">
                <i class="icon-base bx bx-plus me-1"></i> @T("Thêm ví mới", "Add New Wallet")
            </button>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-0">@Model.ErrorMessage</div>
            }
            else if (Model.Wallets.Any())
            {
                <div class="row g-4 wallet-grid">
                    @foreach (var wallet in Model.Wallets)
                    {
                        <div class="col-12 col-md-6 col-xl-4 col-wallet">
                            <button type="button"
                                    class="card wallet-card-static text-start"
                                    data-bs-toggle="modal"
                                    data-bs-target="#walletDetailModal"
                                    data-wallet-id="@wallet.WalletId"
                                    data-wallet-name="@wallet.WalletName"
                                    data-wallet-balance="@wallet.CurrentBalance"
                                    data-wallet-initial="@wallet.InitialBalance"
                                    data-wallet-currency="@wallet.Currency"
                                    data-wallet-is-default="@wallet.IsDefault.ToString().ToLowerInvariant()"
                                    data-wallet-icon="">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold">@wallet.WalletName</div>
                                            <small class="text-body-secondary">@wallet.WalletId</small>
                                        </div>
                                        @if (wallet.IsDefault)
                                        {
                                            <span class="badge bg-label-success">@T("Mặc định", "Default")</span>
                                        }
                                    </div>
                                    <div class="mt-3 fs-5 fw-bold">@wallet.CurrentBalance.ToString("N0") @wallet.Currency</div>
                                    <small class="text-body-secondary">@T("Số dư ban đầu", "Initial balance"): @wallet.InitialBalance.ToString("N0") @wallet.Currency</small>
                                </div>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">@T("Bạn chưa có ví nào.", "You do not have any wallet yet.")</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-controller="Dashboard" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">@T("Tháng", "Month")</label>
                    <input type="number" class="form-control" name="month" min="1" max="12" value="@Model.SelectedMonth" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@T("Năm", "Year")</label>
                    <input type="number" class="form-control" name="year" min="2000" max="2100" value="@Model.SelectedYear" />
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-primary me-2">@T("Xem báo cáo", "Load reports")</button>
                    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="ExportMonthlySummaryCsv" asp-route-year="@Model.SelectedYear">@T("Xuất tổng hợp năm CSV", "Export yearly summary CSV")</a>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ReportErrorMessage))
    {
        <div class="alert alert-warning mb-4">@Model.ReportErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary">@T("Tổng số dư", "Total Balance")</div>
                <h4 class="mb-1">@Model.TotalBalance.ToString("N0") VND</h4>
                <small>@T("Toàn bộ ví hiện tại", "Across all current wallets")</small>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary">@T("Tổng thu tháng", "Monthly Income")</div>
                <h4 class="mb-1 text-success">@Model.MonthlyIncome.ToString("N0") VND</h4>
                <small>@T("Theo tháng đang chọn", "For selected month")</small>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary">@T("Tổng chi tháng", "Monthly Expense")</div>
                <h4 class="mb-1 text-danger">@Model.MonthlyExpense.ToString("N0") VND</h4>
                <small>@T("Theo tháng đang chọn", "For selected month")</small>
            </div></div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card"><div class="card-body">
                <div class="text-body-secondary">@T("Chênh lệch / Số giao dịch", "Net / Transactions")</div>
                <h4 class="mb-1 @(Model.NetCashflow >= 0 ? "text-primary" : "text-danger")">@Model.NetCashflow.ToString("N0") VND</h4>
                <small>@Model.TransactionCount @T("giao dịch trong tháng", "transactions this month")</small>
            </div></div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@T("Xu hướng thu chi theo tháng", "Monthly income & expense trend")</h6>
                        <small class="text-body-secondary">@T("Dữ liệu của cả năm đang chọn.", "Data for the selected year.")</small>
                    </div>
                    <div class="dashboard-export-links">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ExportMonthlySummaryCsv" asp-route-year="@Model.SelectedYear">CSV</a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="dashboardCashflowChart"
                         data-labels='@Html.Raw(trendLabels)'
                         data-income='@Html.Raw(trendIncome)'
                         data-expense='@Html.Raw(trendExpense)'></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@T("Cơ cấu chi tiêu", "Expense breakdown")</h6>
                        <small class="text-body-secondary">@T("Theo tháng đang chọn.", "For selected month.")</small>
                    </div>
                    <div class="dashboard-export-links">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ExportCategorySummaryCsv" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear">CSV</a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="dashboardExpenseDonutChart"
                         data-labels='@Html.Raw(donutLabels)'
                         data-series='@Html.Raw(donutSeries)'
                         data-colors='@Html.Raw(donutColors)'></div>

                    @if (Model.CategoryBreakdown.Any())
                    {
                        <div class="mt-3">
                            @foreach (var item in Model.CategoryBreakdown)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width:10px;height:10px;border-radius:999px;background:@item.Color;display:inline-block"></span>
                                        <span>@item.CategoryName</span>
                                    </div>
                                    <strong>@item.Percentage.ToString("0.##")%</strong>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-body-secondary">@T("Chưa có dữ liệu chi tiêu trong kỳ.", "No expense data for the selected period.")</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@T("Top khoản chi lớn nhất", "Top expenses")</h6>
                        <small class="text-body-secondary">@T("Các giao dịch expense lớn nhất trong tháng.", "Largest expense transactions in the month.")</small>
                    </div>
                    <div class="dashboard-export-links">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ExportTopExpensesCsv" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear">CSV</a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.TopExpenses.Any())
                    {
                        @foreach (var item in Model.TopExpenses)
                        {
                            <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                                <div>
                                    <div class="fw-semibold">@item.Note</div>
                                    <small class="text-body-secondary">@item.CategoryName • @item.WalletName • @item.TransactionDate.ToString("dd/MM/yyyy")</small>
                                </div>
                                <strong class="text-danger">-@item.Amount.ToString("N0")</strong>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-body-secondary">@T("Không có khoản chi nào trong kỳ.", "No expenses in the selected period.")</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-1">@T("Tiến độ ngân sách", "Budget progress")</h6>
                    <small class="text-body-secondary">@T("Thay thế mục tiêu tiết kiệm giả lập bằng dữ liệu budget thật.", "Replaces the placeholder saving goal with real budget data.")</small>
                </div>
                <div class="card-body">
                    @if (Model.BudgetProgress.Any())
                    {
                        @foreach (var item in Model.BudgetProgress)
                        {
                            var color = item.Status == "over" ? "#ff3e1d" : item.Status == "reached" ? "#ffab00" : "#696cff";
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <div class="fw-semibold">@item.CategoryName</div>
                                    <small>@item.SpentAmount.ToString("N0") / @item.LimitAmount.ToString("N0")</small>
                                </div>
                                <div class="budget-progress-bar">
                                    <div class="budget-progress-fill" style="width:@Math.Min(item.PercentageUsed, 100)m; background:@color"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <small class="text-body-secondary">@item.Status</small>
                                    <small class="text-body-secondary">@item.PercentageUsed.ToString("0.##")%</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-body-secondary">@T("Không có budget tháng cho kỳ này.", "No monthly budget for this period.")</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Wallet Modal -->
<div class="modal fade wallet-modal" id="addWalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg wallet-modal-smaller">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h4 class="modal-title mb-1">@T("Thêm ví mới", "Add New Wallet")</h4>
                    <p class="text-body-secondary mb-0">@T("Tạo nhanh một ví mới từ API Wallet.", "Create a new wallet using the Wallet API.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="walletActionAlert" class="alert alert-danger d-none"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên ví", "Wallet name")</label>
                        <input type="text" id="addWalletName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                        <input type="number" id="addInitialBalance" class="form-control" value="0" min="0" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Loại tiền", "Currency")</label>
                        <select id="addWalletCurrencyCode" class="form-select">
                            @foreach (var currency in currencyOptions)
                            {
                                <option value="@currency.Code">@(lang == "en" ? currency.NameEn : currency.NameVi) (@currency.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="addWalletDefault" />
                            <label class="form-check-label" for="addWalletDefault">@T("Đặt làm ví mặc định", "Set as default wallet")</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-primary" id="btnSaveWalletApi">@T("Lưu ví", "Save wallet")</button>
            </div>
        </div>
    </div>
</div>

<!-- Wallet Detail Modal -->
<div class="modal fade wallet-modal" id="walletDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg wallet-modal-smaller">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h4 class="modal-title mb-1" id="detailWalletTitle">@T("Chi tiết ví", "Wallet detail")</h4>
                    <p class="text-body-secondary mb-0"><span id="detailWalletId">-</span></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="detailWalletActionAlert" class="alert alert-danger d-none"></div>
                <input type="hidden" id="detailWalletIdValue" />
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên ví", "Wallet name")</label>
                        <input type="text" id="detailWalletName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Loại tiền", "Currency")</label>
                        <select id="detailWalletCurrencySelect" class="form-select">
                            @foreach (var currency in currencyOptions)
                            {
                                <option value="@currency.Code">@(lang == "en" ? currency.NameEn : currency.NameVi) (@currency.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Số dư hiện tại", "Current balance")</label>
                        <input type="text" id="detailCurrentBalanceInput" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                        <input type="text" id="detailInitialBalance" class="form-control" readonly />
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="detailWalletDefault" />
                            <label class="form-check-label" for="detailWalletDefault">@T("Ví mặc định", "Default wallet")</label>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div>
                    <h6 class="mb-3 text-danger">@T("Xóa ví", "Delete wallet")</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeDeleteAll" value="delete_all" checked />
                        <label class="form-check-label" for="deleteWalletModeDeleteAll">@T("Xóa ví và các giao dịch liên quan", "Delete wallet and related transactions")</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeMove" value="move_transactions" />
                        <label class="form-check-label" for="deleteWalletModeMove">@T("Chuyển giao dịch sang ví khác", "Move transactions to another wallet")</label>
                    </div>
                    <div id="replacementWalletGroup" class="d-none">
                        <label class="form-label">@T("Ví nhận giao dịch", "Replacement wallet")</label>
                        <select id="replacementWalletId" class="form-select">
                            <option value="">@T("Chọn ví", "Select wallet")</option>
                            @foreach (var wallet in Model.Wallets)
                            {
                                <option value="@wallet.WalletId">@wallet.WalletName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-danger" id="btnDeleteWalletApi">@T("Xóa ví", "Delete wallet")</button>
                <div>
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                    <button type="button" class="btn btn-primary" id="btnUpdateWalletApi">@T("Lưu thay đổi", "Save changes")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="walletSavedToast" class="toast text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body">@T("Tạo ví thành công.", "Wallet created successfully.")</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    <div id="walletUpdatedToast" class="toast text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body">@T("Cập nhật ví thành công.", "Wallet updated successfully.")</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    <div id="walletDeletedToast" class="toast text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body">@T("Xóa ví thành công.", "Wallet deleted successfully.")</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
</div>

@section Scripts {
    <script src="~/sneat/libs/apex-charts/apexcharts.js"></script>
    <script src="~/sneat/js/pages/wallet-dashboard.js"></script>
}
