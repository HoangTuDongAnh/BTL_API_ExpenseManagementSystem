@model ExpenseWeb.Models.ViewModels.Dashboard.DashboardIndexViewModel
@using System.Linq
@using System.Text.Json

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    var orderedWallets = Model.Wallets
        .OrderByDescending(x => x.IsDefault)
        .ThenBy(x => x.WalletName)
        .ToList();

    var trendLabels = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Label));
    var trendIncome = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Income));
    var trendExpense = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Expense));

    var donutLabels = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.CategoryName));
    var donutSeries = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.TotalAmount));
    var donutColors = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => string.IsNullOrWhiteSpace(x.Color) ? "#696cff" : x.Color));

    var warningBudgets = Model.BudgetProgress
        .Where(x => x.Status == "over" || x.Status == "reached" || x.PercentageUsed >= 80)
        .OrderByDescending(x => x.PercentageUsed)
        .Take(4)
        .ToList();

    var warningCount = warningBudgets.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/core-page-hero.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/wallet-dashboard.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/dashboard-overview.css" />
}

<div class="dashboard-page" data-dashboard-insights-url="@Url.Action("Insights", "Dashboard")">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Bảng điều khiển tài chính", "Finance dashboard")</span>
            <h1 class="dashboard-hero-title">
                @T("Nhìn rõ ví tiền, nhịp thu chi và báo cáo quan trọng mỗi ngày.", "See your wallets, cashflow rhythm, and key reports more clearly each day.")
            </h1>
            <p class="dashboard-hero-text">
                @T("Theo dõi số dư hiện có, biến động trong kỳ và những chỉ số nổi bật để việc quản lý chi tiêu trở nên chủ động hơn.",
                "Track current balances, period changes, and standout indicators so managing your spending feels more proactive.")
            </p>
        </div>
    </section>

    <section class="card wallet-section-card mb-4">
        <div class="card-body">
            <div class="wallet-section-header">
                <div>
                    <h2 class="wallet-section-title">@T("Quản lý ví", "Wallets")</h2>
                    <p class="wallet-section-subtitle">
                        @T("Mỗi ví đại diện cho một nguồn tiền bạn đang theo dõi. Ví mặc định sẽ được chọn sẵn khi tạo giao dịch mới.", "Each wallet represents a money source you track. The default wallet is preselected when creating a new transaction.")
                    </p>
                </div>
                <button type="button" class="btn btn-primary wallet-add-btn" data-bs-toggle="modal" data-bs-target="#addWalletModal">
                    <i class="bx bx-plus me-1"></i>@T("Thêm ví mới", "Add wallet")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-0">@Model.ErrorMessage</div>
            }
            else if (orderedWallets.Any())
            {
                <div class="wallet-grid">
                    @foreach (var wallet in orderedWallets)
                    {
                        <button type="button"
                                class="wallet-card-static text-start"
                                data-bs-toggle="modal"
                                data-bs-target="#walletDetailModal"
                                data-wallet-id="@wallet.WalletId"
                                data-wallet-name="@wallet.WalletName"
                                data-wallet-balance="@wallet.CurrentBalance"
                                data-wallet-initial="@wallet.InitialBalance"
                                data-wallet-currency="@wallet.Currency"
                                data-wallet-is-default="@wallet.IsDefault.ToString().ToLowerInvariant()">
                            <div class="wallet-card-body">
                                <div class="wallet-card-top">
                                    <span class="wallet-card-icon"><i class="bx bx-wallet"></i></span>
                                    <div class="wallet-card-meta">
                                        <h3 class="wallet-card-name">@wallet.WalletName</h3>
                                        <p class="wallet-card-note">@T("Sẵn sàng dùng cho giao dịch", "Ready for transactions")</p>
                                    </div>
                                    @if (wallet.IsDefault)
                                    {
                                        <span class="wallet-default-badge"><i class="bx bx-check-circle"></i>@T("Ví mặc định", "Default")</span>
                                    }
                                </div>
                                <div class="wallet-card-balance">@wallet.CurrentBalance.ToString("N0") @wallet.Currency</div>
                                <div class="wallet-card-helper">@T("Chạm để xem chi tiết, chỉnh sửa hoặc đổi thiết lập ví.", "Open details to edit this wallet or update its settings.")</div>
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info wallet-empty-state mb-0">@T("Bạn chưa có ví nào. Hãy tạo ví đầu tiên để bắt đầu ghi nhận thu chi.", "You do not have a wallet yet. Create your first wallet to start tracking money.")</div>
            }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ReportErrorMessage))
    {
        <div class="alert alert-warning mb-4">@Model.ReportErrorMessage</div>
    }

    <section class="dashboard-mini-grid mb-4">
        <article class="dashboard-mini-card danger">
            <span class="dashboard-mini-icon"><i class="bx bx-trending-down"></i></span>
            <div class="dashboard-mini-copy">
                <div class="dashboard-mini-label">@T("Chi hôm nay", "Today expense")</div>
                <div class="dashboard-mini-value">@Model.TodayExpense.ToString("N0")</div>
                <div class="dashboard-mini-meta">@Model.TodayExpenseCount @T("giao dịch chi", "expense transactions")</div>
            </div>
        </article>
        <article class="dashboard-mini-card success">
            <span class="dashboard-mini-icon"><i class="bx bx-trending-up"></i></span>
            <div class="dashboard-mini-copy">
                <div class="dashboard-mini-label">@T("Thu hôm nay", "Today income")</div>
                <div class="dashboard-mini-value">@Model.TodayIncome.ToString("N0")</div>
                <div class="dashboard-mini-meta">@Model.TodayIncomeCount @T("giao dịch thu", "income transactions")</div>
            </div>
        </article>
        <article class="dashboard-mini-card primary">
            <span class="dashboard-mini-icon"><i class="bx bx-wallet-alt"></i></span>
            <div class="dashboard-mini-copy">
                <div class="dashboard-mini-label">@T("Tổng số dư hiện có", "Current total balance")</div>
                <div class="dashboard-mini-value">@Model.TotalBalance.ToString("N0")</div>
                <div class="dashboard-mini-meta">@Model.ActiveWalletCount @T("ví đang hoạt động", "active wallets")</div>
            </div>
        </article>
        <article class="dashboard-mini-card warning">
            <span class="dashboard-mini-icon"><i class="bx bx-error-circle"></i></span>
            <div class="dashboard-mini-copy">
                <div class="dashboard-mini-label">@T("Ngân sách cần chú ý", "Budgets to review")</div>
                <div class="dashboard-mini-value">@warningCount</div>
                <div class="dashboard-mini-meta">@warningBudgets.Count(x => x.Status == "over") @T("đã vượt", "over") • @warningBudgets.Count(x => x.Status != "over") @T("sắp chạm mức", "near limit")</div>
            </div>
        </article>
    </section>

    <section class="card dashboard-report-card mb-4">
        <div class="card-body">
            <div class="dashboard-card-head">
                <div>
                    <span class="dashboard-card-eyebrow">@T("Xu hướng thu chi", "Cashflow trend")</span>
                    <h2 class="dashboard-card-title" id="dashboardTrendTitle">@T("Thu và chi trong", "Income and expense in") @Model.PeriodLabel.ToLower()</h2>
                    <p class="dashboard-card-text" id="dashboardTrendSubtitle">@T("Chọn nhanh khung thời gian để xem nhịp thu chi theo tuần gần nhất, tháng hiện tại hoặc toàn bộ năm.", "Quickly switch between the last 7 days, current month, or the full year.")</p>
                </div>
                <div class="dashboard-card-actions">
                    <div class="dashboard-period-switch" role="tablist" aria-label="Dashboard period">
                        <button type="button" class="period-chip @(Model.PeriodPreset == "week" ? "active" : null)" data-period-chip="week">7 @T("ngày", "days")</button>
                        <button type="button" class="period-chip @(Model.PeriodPreset == "month" ? "active" : null)" data-period-chip="month">@T("Tháng này", "This month")</button>
                        <button type="button" class="period-chip @(Model.PeriodPreset == "year" ? "active" : null)" data-period-chip="year">@T("Năm nay", "This year")</button>
                    </div>
                    <a class="dashboard-link-action" asp-controller="Transaction" asp-action="Index">@T("Mở trang giao dịch", "Open transactions") <i class="bx bx-right-arrow-alt"></i></a>
                </div>
            </div>

            <div class="dashboard-trend-chart-shell">
                <canvas id="dashboardCashflowChart"
                        data-labels='@Html.Raw(trendLabels)'
                        data-income='@Html.Raw(trendIncome)'
                        data-expense='@Html.Raw(trendExpense)'></canvas>
            </div>

            <div class="dashboard-trend-stats" id="dashboardTrendStats">
                <div class="trend-stat-box">
                    <span class="label">@T("Tổng thu", "Income")</span>
                    <strong id="dashboardRangeIncome">@Model.RangeIncome.ToString("N0")</strong>
                </div>
                <div class="trend-stat-box">
                    <span class="label">@T("Tổng chi", "Expense")</span>
                    <strong id="dashboardRangeExpense">@Model.RangeExpense.ToString("N0")</strong>
                </div>
                <div class="trend-stat-box">
                    <span class="label">@T("Giao dịch", "Transactions")</span>
                    <strong id="dashboardRangeTransactionCount">@Model.RangeTransactionCount</strong>
                </div>
                <div class="trend-stat-box">
                    <span class="label">@T("Nhịp nổi bật", "Busiest point")</span>
                    <strong id="dashboardBusiestLabel">@(string.IsNullOrWhiteSpace(Model.BusiestLabel) ? T("Chưa có", "No data") : Model.BusiestLabel)</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="dashboard-split-grid mb-4">
        <article class="card dashboard-report-card">
            <div class="card-body">
                <div class="dashboard-card-head compact">
                    <div>
                        <span class="dashboard-card-eyebrow">@T("Hoạt động trong ngày", "Daily activity")</span>
                        <h2 class="dashboard-card-title">@T("Giao dịch hôm nay", "Today's transactions")</h2>
                    </div>
                    <a class="dashboard-link-action" asp-controller="Transaction" asp-action="Index">@T("Xem tất cả", "View all") <i class="bx bx-right-arrow-alt"></i></a>
                </div>

                @if (Model.RecentTransactions.Any())
                {
                    <div class="dashboard-table-wrap">
                        <table class="dashboard-mini-table">
                            <thead>
                                <tr>
                                    <th>@T("Danh mục", "Category")</th>
                                    <th>@T("Ví", "Wallet")</th>
                                    <th>@T("Ghi chú", "Note")</th>
                                    <th class="text-end">@T("Số tiền", "Amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentTransactions.Take(5))
                                {
                                    var icon = string.IsNullOrWhiteSpace(item.CategoryIcon) ? "bx-category" : item.CategoryIcon;
                                    var isIncome = item.TransactionType == "income";
                                    <tr>
                                        <td>
                                            <div class="txn-category-cell">
                                                <span class="txn-category-icon" style="background:@(string.IsNullOrWhiteSpace(item.CategoryColor) ? "#eef2ff" : item.CategoryColor + "22"); color:@(string.IsNullOrWhiteSpace(item.CategoryColor) ? "#696cff" : item.CategoryColor)">
                                                    <i class='bx @icon'></i>
                                                </span>
                                                <div>
                                                    <strong>@item.CategoryName</strong>
                                                    <small>@item.TransactionDate.ToString("dd/MM")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.WalletName</td>
                                        <td class="txn-note">@item.Note</td>
                                        <td class="text-end @(isIncome ? "amount-income" : "amount-expense")">@(isIncome ? "+" : "-")@item.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state small-empty">
                        <span class="dashboard-empty-icon"><i class="bx bx-receipt"></i></span>
                        <h3>@T("Hôm nay chưa có giao dịch nào", "No transactions yet today")</h3>
                        <p>@T("Khi bạn thêm giao dịch mới, dashboard sẽ hiển thị 3 - 5 giao dịch gần nhất ngay tại đây.", "New transactions will appear here as a compact table once they are created.")</p>
                    </div>
                }
            </div>
        </article>

        <article class="card dashboard-report-card">
            <div class="card-body">
                <div class="dashboard-card-head compact">
                    <div>
                        <span class="dashboard-card-eyebrow">@T("Cơ cấu chi tiêu", "Spending breakdown")</span>
                        <h2 class="dashboard-card-title" id="dashboardDonutTitle">@T("Danh mục chi tiêu trong", "Spending categories in") @Model.PeriodLabel.ToLower()</h2>
                    </div>
                    <a class="dashboard-link-action" asp-controller="Category" asp-action="Index">@T("Quản lý danh mục", "Manage categories") <i class="bx bx-right-arrow-alt"></i></a>
                </div>

                <div id="dashboardCategoryPanel">
                    @if (Model.CategoryBreakdown.Any())
                    {
                        <div class="dashboard-donut-shell">
                            <canvas id="dashboardExpenseDonutChart"
                                    data-labels='@Html.Raw(donutLabels)'
                                    data-series='@Html.Raw(donutSeries)'
                                    data-colors='@Html.Raw(donutColors)'></canvas>
                        </div>
                        <div class="dashboard-legend-list" id="dashboardCategoryLegend">
                            @foreach (var item in Model.CategoryBreakdown.Take(5))
                            {
                                <div class="legend-row">
                                    <div class="legend-left">
                                        <span class="legend-dot" style="background:@item.Color"></span>
                                        <span>@item.CategoryName</span>
                                    </div>
                                    <div class="legend-right">
                                        <strong>@item.Percentage.ToString("0.##")%</strong>
                                        <small>@item.TotalAmount.ToString("N0")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state small-empty">
                            <span class="dashboard-empty-icon"><i class="bx bx-pie-chart-alt-2"></i></span>
                            <h3>@T("Chưa có dữ liệu chi tiêu", "No spending data yet")</h3>
                            <p>@T("Biểu đồ tròn sẽ xuất hiện khi kỳ đang xem có giao dịch chi tiêu.", "The doughnut chart will appear once there are expense transactions in the selected period.")</p>
                        </div>
                    }
                </div>
            </div>
        </article>
    </section>

    <section class="card dashboard-report-card mb-4">
        <div class="card-body">
            <div class="dashboard-card-head compact">
                <div>
                    <span class="dashboard-card-eyebrow">@T("Cảnh báo nhanh", "Quick alerts")</span>
                    <h2 class="dashboard-card-title">@T("Ngân sách cần chú ý", "Budgets to review")</h2>
                </div>
                <a class="dashboard-link-action" asp-controller="Category" asp-action="Index">@T("Quản lý danh mục và budget", "Open categories & budgets") <i class="bx bx-right-arrow-alt"></i></a>
            </div>

            <div id="dashboardBudgetPanel">
                @if (warningBudgets.Any())
                {
                    <div class="budget-alert-grid" id="dashboardBudgetAlerts">
                        @foreach (var item in warningBudgets)
                        {
                            var statusClass = item.Status == "over" ? "over" : item.Status == "reached" ? "reached" : "warning";
                            var statusText = item.Status == "over"
                                ? T("Đã vượt mức", "Over budget")
                                : item.Status == "reached"
                                    ? T("Đã chạm mức", "Reached limit")
                                    : T("Sắp chạm mức", "Near limit");
                            var percentageText = Math.Round(item.PercentageUsed, 0).ToString("0");
                            <article class="budget-alert-card @statusClass">
                                <div class="budget-alert-head">
                                    <div class="budget-alert-title-wrap">
                                        <span class="budget-alert-dot" style="background:@(string.IsNullOrWhiteSpace(item.CategoryColor) ? "#696cff" : item.CategoryColor)"></span>
                                        <div>
                                            <h3>@item.CategoryName</h3>
                                            <p>@statusText</p>
                                        </div>
                                    </div>
                                    <span class="budget-alert-badge">@percentageText%</span>
                                </div>
                                <div class="budget-alert-bar"><span style="width:@Math.Min(item.PercentageUsed, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                                <div class="budget-alert-meta">
                                    <span>@item.SpentAmount.ToString("N0") / @item.LimitAmount.ToString("N0")</span>
                                    <span>@T("Còn lại", "Remaining"): @item.RemainingAmount.ToString("N0")</span>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state small-empty alert-empty-ok">
                        <span class="dashboard-empty-icon success"><i class="bx bx-check-shield"></i></span>
                        <h3>@T("Chưa có ngân sách nào vượt ngưỡng", "No budgets need attention")</h3>
                        <p>@T("Hiện chưa có danh mục nào vượt hoặc gần chạm mức cảnh báo trong tháng này.", "No budget category is over or near its warning threshold this month.")</p>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
<div class="modal fade wallet-modal wallet-modal-unified mimo-popup" id="addWalletModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".wallet-modal-hero" data-popup-source-close=".wallet-modal-close" data-popup-title=".wallet-modal-title" data-popup-subtitle=".wallet-modal-subtitle">
    <div class="modal-dialog modal-dialog-centered modal-xl wallet-modal-dialog">
        <div class="modal-content wallet-modal-content-shell">
            <button type="button" class="wallet-modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="bx bx-x"></i>
            </button>
            <div class="wallet-modal-hero">
                <div>
                    <h4 class="wallet-modal-title">@T("Thêm ví mới", "Add new wallet")</h4>
                    <p class="wallet-modal-subtitle mb-0">@T("Tạo một ví để theo dõi tiền mặt, tài khoản ngân hàng hoặc quỹ cá nhân. Biểu mẫu được giữ gọn và đồng nhất với popup các trang khác.", "Create a wallet to track cash, bank accounts, or personal funds. The form stays compact and visually aligned with other popups.")</p>
                </div>
            </div>
            <div class="modal-body wallet-modal-body-shell">
                <div id="walletActionAlert" class="alert alert-danger d-none"></div>
                <section class="wallet-form-card">
                    <div class="wallet-form-card-head">
                        <span class="wallet-form-card-icon"><i class="bx bx-wallet"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title">@T("Thông tin ví", "Wallet information")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Nhập các thông tin cơ bản để tạo ví và thiết lập ví mặc định nếu cần.", "Enter the basic wallet details and set it as default if needed.")</p>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">@T("Tên ví", "Wallet name")</label>
                            <input type="text" id="addWalletName" class="form-control wallet-input" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                            <input type="number" id="addInitialBalance" class="form-control wallet-input" value="0" min="0" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Loại tiền", "Currency")</label>
                            <select id="addWalletCurrencyCode" class="form-select wallet-input">
                                <option value="VND">VND</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="JPY">JPY</option>
                                <option value="KRW">KRW</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="wallet-switch-card h-100">
                                <div class="form-check form-switch wallet-form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="addWalletDefault" />
                                    <label class="form-check-label" for="addWalletDefault">@T("Đặt làm ví mặc định", "Set as default wallet")</label>
                                </div>
                                <div class="wallet-switch-helper">@T("Ví này sẽ được chọn sẵn khi tạo giao dịch mới.", "This wallet will be preselected when you create a new transaction.")</div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
            <div class="modal-footer wallet-modal-footer-shell">
                <button type="button" class="btn btn-label-secondary wallet-btn-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-primary wallet-btn-primary" id="btnSaveWalletApi">@T("Lưu ví", "Save wallet")</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade wallet-modal wallet-modal-unified mimo-popup" id="walletDetailModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".wallet-modal-hero" data-popup-source-close=".wallet-modal-close" data-popup-title=".wallet-modal-title" data-popup-subtitle=".wallet-modal-subtitle" data-popup-extra=".wallet-hero-badge">
    <div class="modal-dialog modal-dialog-centered modal-xl wallet-modal-dialog">
        <div class="modal-content wallet-modal-content-shell">
            <button type="button" class="wallet-modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="bx bx-x"></i>
            </button>
            <div class="wallet-modal-hero wallet-modal-hero-with-badge">
                <div>
                    <h4 class="wallet-modal-title" id="detailWalletTitle">@T("Chi tiết ví", "Wallet details")</h4>
                    <p class="wallet-modal-subtitle mb-0"><span id="detailWalletId">-</span></p>
                </div>
                <span class="wallet-hero-badge" id="detailWalletBadge">@T("Ví thường", "Standard wallet")</span>
            </div>
            <div class="modal-body wallet-modal-body-shell">
                <div id="detailWalletActionAlert" class="alert alert-danger d-none"></div>
                <input type="hidden" id="detailWalletIdValue" />

                <section class="wallet-form-card mb-4">
                    <div class="wallet-form-card-head">
                        <span class="wallet-form-card-icon"><i class="bx bx-detail"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title">@T("Thông tin ví", "Wallet information")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Cập nhật tên ví, loại tiền, trạng thái mặc định và theo dõi số dư hiện tại của ví này.", "Update the wallet name, currency, default status, and review its current balance.")</p>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">@T("Tên ví", "Wallet name")</label>
                            <input type="text" id="detailWalletName" class="form-control wallet-input" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Loại tiền", "Currency")</label>
                            <select id="detailWalletCurrencySelect" class="form-select wallet-input">
                                <option value="VND">VND</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="JPY">JPY</option>
                                <option value="KRW">KRW</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư hiện tại", "Current balance")</label>
                            <input type="text" id="detailCurrentBalanceInput" class="form-control wallet-input" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                            <input type="text" id="detailInitialBalance" class="form-control wallet-input" readonly />
                        </div>
                        <div class="col-md-12">
                            <div class="wallet-switch-card">
                                <div class="form-check form-switch wallet-form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="detailWalletDefault" />
                                    <label class="form-check-label" for="detailWalletDefault">@T("Ví mặc định", "Default wallet")</label>
                                </div>
                                <div class="wallet-switch-helper">@T("Ví này sẽ được chọn sẵn khi tạo giao dịch mới.", "This wallet will be preselected when you create a new transaction.")</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="wallet-form-card wallet-delete-card">
                    <div class="wallet-form-card-head wallet-form-card-head-danger">
                        <span class="wallet-form-card-icon wallet-form-card-icon-danger"><i class="bx bx-trash"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title text-danger">@T("Xóa ví", "Delete wallet")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Chọn cách xử lý các giao dịch liên quan trước khi xóa ví này.", "Choose how related transactions should be handled before deleting this wallet.")</p>
                        </div>
                    </div>
                    <div class="wallet-delete-options">
                        <label class="wallet-radio-card">
                            <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeDeleteAll" value="delete_all" checked />
                            <span>
                                <strong>@T("Xóa ví và các giao dịch liên quan", "Delete wallet and related transactions")</strong>
                                <small>@T("Phù hợp khi ví này không còn cần lưu lịch sử.", "Use this when the wallet history is no longer needed.")</small>
                            </span>
                        </label>
                        <label class="wallet-radio-card">
                            <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeMove" value="move_transactions" />
                            <span>
                                <strong>@T("Chuyển giao dịch sang ví khác", "Move transactions to another wallet")</strong>
                                <small>@T("Giữ lại lịch sử giao dịch bằng cách chuyển sang ví thay thế.", "Keep the transaction history by moving it to a replacement wallet.")</small>
                            </span>
                        </label>
                    </div>
                    <div id="replacementWalletGroup" class="d-none mt-3">
                        <label class="form-label">@T("Ví nhận giao dịch", "Replacement wallet")</label>
                        <select id="replacementWalletId" class="form-select wallet-input">
                            <option value="">@T("Chọn ví", "Select wallet")</option>
                            @foreach (var wallet in orderedWallets)
                            {
                                <option value="@wallet.WalletId">@wallet.WalletName</option>
                            }
                        </select>
                    </div>
                </section>
            </div>
            <div class="modal-footer wallet-modal-footer-shell wallet-modal-footer-shell-split">
                <button type="button" class="btn btn-danger wallet-btn-danger" id="btnDeleteWalletApi">@T("Xóa ví", "Delete wallet")</button>
                <div class="wallet-footer-actions">
                    <button type="button" class="btn btn-label-secondary wallet-btn-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                    <button type="button" class="btn btn-primary wallet-btn-primary" id="btnUpdateWalletApi">@T("Lưu thay đổi", "Save changes")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade wallet-confirm-modal" id="walletDeleteConfirmModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".modal-header" data-popup-title=".modal-title" data-popup-head-compact="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">@T("Xác nhận xóa ví", "Confirm wallet deletion")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-0 text-body-secondary">@T("Bạn có chắc muốn xóa ví này không? Hành động này có thể ảnh hưởng đến giao dịch liên quan.", "Are you sure you want to delete this wallet? This action can affect related transactions.")</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteWallet">@T("Xóa ví", "Delete wallet")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/sneat/js/pages/wallet-dashboard.js"></script>
    <script src="~/sneat/js/pages/dashboard-overview.js"></script>
}
