@model ExpenseWeb.Models.ViewModels.Dashboard.DashboardIndexViewModel
@using System.Linq
@using System.Text.Json

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    var orderedWallets = Model.Wallets
        .OrderByDescending(x => x.IsDefault)
        .ThenBy(x => x.WalletName)
        .ToList();

    var trendLabels = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Label));
    var trendIncome = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Income));
    var trendExpense = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Expense));
    var trendNet = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.Net));
    var trendRunningBalance = JsonSerializer.Serialize(Model.CashflowSeries.Select(x => x.RunningBalance));

    var donutLabels = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.CategoryName));
    var donutSeries = JsonSerializer.Serialize(Model.CategoryBreakdown.Select(x => x.TotalAmount));
    var donutColors = JsonSerializer.Serialize(
        Model.CategoryBreakdown.Select(x => string.IsNullOrWhiteSpace(x.Color) ? "#696cff" : x.Color)
    );
    var donutIcons = JsonSerializer.Serialize(
        Model.CategoryBreakdown.Select(x => string.IsNullOrWhiteSpace(x.Icon) ? "" : x.Icon)
    );

    var topCategory = Model.CategoryBreakdown.FirstOrDefault();
    var overBudgetCount = Model.BudgetProgress.Count(x => x.Status == "over" || x.Status == "reached");
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/wallet-dashboard.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/report-page.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Bảng điều khiển tài chính", "Finance dashboard")</span>
            <h1 class="dashboard-hero-title">
                @T("Nhìn rõ ví tiền, nhịp thu chi và báo cáo quan trọng mỗi ngày.", "See your wallets, cashflow rhythm, and key reports more clearly each day.")
            </h1>
            <p class="dashboard-hero-text">
                @T(
                "Theo dõi số dư hiện có, biến động trong kỳ và những chỉ số nổi bật để việc quản lý chi tiêu trở nên chủ động hơn.",
                                "Track current balances, period changes, and standout indicators so managing your spending feels more proactive.")
            </p>
        </div>
    </section>

    <section class="card wallet-section-card mb-4">
        <div class="card-body">
            <div class="wallet-section-header">
                <div>
                    <h2 class="wallet-section-title">@T("Quản lý ví", "Wallets")</h2>
                    <p class="wallet-section-subtitle">
                        @T("Mỗi ví đại diện cho một nguồn tiền bạn đang theo dõi. Ví mặc định sẽ được chọn sẵn khi tạo giao dịch mới.", "Each wallet represents a money source you track. The default wallet is preselected when creating a new transaction.")
                    </p>
                </div>
                <button type="button" class="btn btn-primary wallet-add-btn" data-bs-toggle="modal" data-bs-target="#addWalletModal">
                    <i class="bx bx-plus me-1"></i>@T("Thêm ví mới", "Add wallet")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-0">@Model.ErrorMessage</div>
            }
            else if (orderedWallets.Any())
            {
                <div class="wallet-grid">
                    @foreach (var wallet in orderedWallets)
                    {
                        <button type="button"
                                class="wallet-card-static text-start"
                                data-bs-toggle="modal"
                                data-bs-target="#walletDetailModal"
                                data-wallet-id="@wallet.WalletId"
                                data-wallet-name="@wallet.WalletName"
                                data-wallet-balance="@wallet.CurrentBalance"
                                data-wallet-initial="@wallet.InitialBalance"
                                data-wallet-currency="@wallet.Currency"
                                data-wallet-is-default="@wallet.IsDefault.ToString().ToLowerInvariant()">
                            <div class="wallet-card-body">
                                <div class="wallet-card-top">
                                    <span class="wallet-card-icon"><i class="bx bx-wallet"></i></span>
                                    <div class="wallet-card-meta">
                                        <h3 class="wallet-card-name">@wallet.WalletName</h3>
                                        <p class="wallet-card-note">@T("Sẵn sàng dùng cho giao dịch", "Ready for transactions")</p>
                                    </div>
                                    @if (wallet.IsDefault)
                                    {
                                        <span class="wallet-default-badge"><i class="bx bx-check-circle"></i>@T("Ví mặc định", "Default")</span>
                                    }
                                </div>
                                <div class="wallet-card-balance">@wallet.CurrentBalance.ToString("N0") @wallet.Currency</div>
                                <div class="wallet-card-helper">@T("Chạm để xem chi tiết, chỉnh sửa hoặc đổi thiết lập ví.", "Open details to edit this wallet or update its settings.")</div>
                            </div>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info wallet-empty-state mb-0">@T("Bạn chưa có ví nào. Hãy tạo ví đầu tiên để bắt đầu ghi nhận thu chi.", "You do not have a wallet yet. Create your first wallet to start tracking money.")</div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ReportErrorMessage))
    {
        <div class="alert alert-warning mb-4">@Model.ReportErrorMessage</div>
    }

    <section class="dashboard-section-head mb-3">
        <div>
            <h2 class="dashboard-section-title">@T("Bộ lọc báo cáo", "Report filters")</h2>
            <p class="dashboard-section-text">@T("Chọn nhanh khoảng thời gian và cách nhóm dữ liệu để cập nhật các thẻ tổng quan và báo cáo bên dưới.", "Choose a date range and grouping style to refresh the summary cards and reports below.")</p>
        </div>
    </section>

    <section class="card report-filter-card mb-4">
        <div class="card-body">
            <form method="get" asp-controller="Dashboard" asp-action="Index" class="report-filter-form" id="dashboardFilterForm">
                <div class="report-filter-grid">
                    <div class="report-field">
                        <label class="form-label">@T("Từ ngày", "From")</label>
                        <input type="date" class="form-control" name="startDate" id="filterStartDate" value="@ViewBag.FilterStartDate" />
                    </div>
                    <div class="report-field">
                        <label class="form-label">@T("Đến ngày", "To")</label>
                        <input type="date" class="form-control" name="endDate" id="filterEndDate" value="@ViewBag.FilterEndDate" />
                    </div>
                    <div class="report-field report-field-sm">
                        <label class="form-label">@T("Nhóm theo", "Group by")</label>
                        <select class="form-select" name="groupBy" id="filterGroupBy">
                            <option value="day" selected="@(ViewBag.GroupBy == "day" ? "selected" : null)">@T("Ngày", "Day")</option>
                            <option value="week" selected="@(ViewBag.GroupBy == "week" ? "selected" : null)">@T("Tuần", "Week")</option>
                            <option value="month" selected="@(ViewBag.GroupBy == "month" ? "selected" : null)">@T("Tháng", "Month")</option>
                            <option value="year" selected="@(ViewBag.GroupBy == "year" ? "selected" : null)">@T("Năm", "Year")</option>
                        </select>
                    </div>
                    <div class="report-field report-field-sm">
                        <label class="form-label">@T("Tháng", "Month")</label>
                        <select class="form-select" name="month" id="filterMonth">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == Model.SelectedMonth ? "selected" : null)">@m.ToString("D2")</option>
                            }
                        </select>
                    </div>
                    <div class="report-field report-field-sm">
                        <label class="form-label">@T("Năm", "Year")</label>
                        <select class="form-select" name="year" id="filterYear">
                            @for (var y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 2; y++)
                            {
                                <option value="@y" selected="@(y == Model.SelectedYear ? "selected" : null)">@y</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="report-filter-footer">
                    <div class="report-quick-actions">
                        <button type="button" class="quick-range-btn" data-range="7d">7 @T("ngày", "days")</button>
                        <button type="button" class="quick-range-btn" data-range="30d">30 @T("ngày", "days")</button>
                        <button type="button" class="quick-range-btn" data-range="thisMonth">@T("Tháng này", "This month")</button>
                        <button type="button" class="quick-range-btn" data-range="thisYear">@T("Năm nay", "This year")</button>
                        <span class="report-period-chip">
                            <i class="bx bx-calendar"></i>
                            <span>@Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</span>
                        </span>
                    </div>
                    <div class="report-filter-actions-panel">
                        <button type="submit" class="btn btn-primary report-apply-btn">@T("Áp dụng bộ lọc", "Apply filters")</button>
                        <a class="btn mimo-soft-btn" asp-controller="Dashboard" asp-action="Index" asp-route-month="@DateTime.Now.Month" asp-route-year="@DateTime.Now.Year">@T("Đặt lại", "Reset")</a>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="card dashboard-kpi-section mb-4">
        <div class="card-body">
            <div class="dashboard-section-head dashboard-section-head-compact">
                <div>
                    <h2 class="dashboard-section-title">@T("Tổng quan trong kỳ", "Period overview")</h2>
                    <p class="dashboard-section-text">@T("Bốn chỉ số chính tóm tắt nhanh số dư, thu, chi và dòng tiền ròng của kỳ đang xem.", "Four summary cards for balance, income, expense and net cashflow of the selected period.")</p>
                </div>
            </div>

            <div class="dashboard-kpi-grid">
                <div class="dashboard-kpi-card">
                    <div class="dashboard-kpi-label">@T("Tổng số dư", "Total balance")</div>
                    <h3 class="dashboard-kpi-value">@Model.TotalBalance.ToString("N0") VND</h3>
                    <div class="dashboard-kpi-helper">@T("Tổng hợp từ tất cả ví hiện có.", "Combined across all current wallets.")</div>
                </div>
                <div class="dashboard-kpi-card">
                    <div class="dashboard-kpi-label">@T("Thu trong kỳ", "Income in period")</div>
                    <h3 class="dashboard-kpi-value positive">@Model.RangeIncome.ToString("N0") VND</h3>
                    <div class="dashboard-kpi-helper">@T("Tổng thu trong khoảng thời gian đang lọc.", "Income in the selected date range.")</div>
                </div>
                <div class="dashboard-kpi-card">
                    <div class="dashboard-kpi-label">@T("Chi trong kỳ", "Expense in period")</div>
                    <h3 class="dashboard-kpi-value negative">@Model.RangeExpense.ToString("N0") VND</h3>
                    <div class="dashboard-kpi-helper">@T("Tổng chi trong khoảng thời gian đang lọc.", "Expense in the selected date range.")</div>
                </div>
                <div class="dashboard-kpi-card">
                    <div class="dashboard-kpi-label">@T("Dòng tiền ròng", "Net cashflow")</div>
                    <h3 class="dashboard-kpi-value @(Model.NetCashflow >= 0 ? "positive" : "negative")">@Model.RangeNetChange.ToString("N0") VND</h3>
                    <div class="dashboard-kpi-helper">@Model.RangeTransactionCount @T("giao dịch trong khoảng thời gian đang lọc.", "transactions in the selected date range.")</div>
                </div>
            </div>
        </div>
    </section>

    <section class="report-overview-band mb-4">
        <div class="report-overview-head">
            <div>
                <h2 class="dashboard-section-title">@T("Tổng quan báo cáo nên xem", "Most useful report overview")</h2>
                <p class="dashboard-section-text">@T("Đây là các chỉ dấu chung nhất để dashboard cho biết tình hình hiện tại: danh mục chi chính, mức chi trung bình, nhịp giao dịch và cảnh báo ngân sách.", "These are the broadest signals a dashboard should surface: main spending category, average expense, transaction rhythm, and budget warnings.")</p>
            </div>
        </div>
        <div class="report-overview-grid">
            <article class="report-overview-card">
                <span class="report-overview-icon"><i class="bx bx-pie-chart-alt-2"></i></span>
                <div class="report-overview-label">@T("Danh mục chi lớn nhất", "Top spending category")</div>
                <div class="report-overview-value">@(topCategory?.CategoryName ?? T("Chưa có dữ liệu", "No data yet"))</div>
                <div class="report-overview-helper">
                    @if (topCategory is not null)
                    {
                        <span>@topCategory.TotalAmount.ToString("N0") VND • @topCategory.Percentage.ToString("0.##")%</span>
                    }
                    else
                    {
                        <span>@T("Sẽ hiển thị khi có giao dịch chi tiêu.", "Will appear when expense transactions are available.")</span>
                    }
                </div>
            </article>
            <article class="report-overview-card">
                <span class="report-overview-icon"><i class="bx bx-receipt"></i></span>
                <div class="report-overview-label">@T("Chi trung bình / giao dịch", "Average expense / transaction")</div>
                <div class="report-overview-value">@Model.RangeAverageExpense.ToString("N0") VND</div>
                <div class="report-overview-helper">@Model.RangeTransactionCount @T("giao dịch trong kỳ đang lọc.", "transactions in the selected period.")</div>
            </article>
            <article class="report-overview-card">
                <span class="report-overview-icon"><i class="bx bx-line-chart"></i></span>
                <div class="report-overview-label">@T("Mốc sôi động nhất", "Busiest point")</div>
                <div class="report-overview-value">@(string.IsNullOrWhiteSpace(Model.BusiestLabel) ? T("Chưa xác định", "Not available") : Model.BusiestLabel)</div>
                <div class="report-overview-helper">@T("Mốc có tổng hoạt động mạnh nhất theo bộ lọc hiện tại.", "The point with the highest overall activity under the current filter.")</div>
            </article>
            <article class="report-overview-card @(overBudgetCount > 0 ? "has-alert" : "")">
                <span class="report-overview-icon"><i class="bx bx-shield-quarter"></i></span>
                <div class="report-overview-label">@T("Cảnh báo ngân sách", "Budget alerts")</div>
                <div class="report-overview-value">@overBudgetCount @T("danh mục", "categories")</div>
                <div class="report-overview-helper">@(overBudgetCount > 0 ? T("Đã chạm ngưỡng hoặc vượt hạn mức trong tháng ngân sách đang xem.", "Already reached or exceeded the budget limit in the viewed budget month.") : T("Chưa có danh mục nào chạm ngưỡng ngân sách.", "No category has reached the budget threshold yet."))</div>
            </article>
        </div>
    </section>

    <section class="dashboard-section-head">
        <div>
            <h2 class="dashboard-section-title">@T("Báo cáo cần xem", "Reports worth reviewing")</h2>
            <p class="dashboard-section-text">@T("Bộ báo cáo vừa đủ để nhìn từ bức tranh lớn đến chi tiết: xu hướng, cơ cấu chi tiêu, khoản chi đáng chú ý và mức dùng ngân sách.", "A focused report set that moves from the big picture to details: trend, spending mix, notable expenses, and budget usage.")</p>
        </div>
    </section>

    <div class="report-grid mb-4">
        <div class="card report-card">
            <div class="card-header d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h3 class="report-title">@T("Biến động và số dư lũy kế", "Changes and running balance")</h3>
                    <p class="report-text">@T("Cột thể hiện biến động từng mốc, đường thể hiện số dư lũy kế theo bộ lọc và cách nhóm dữ liệu phía trên.", "Bars show change per point while the line shows running balance based on the selected filter and grouping.")</p>
                </div>
                <a class="btn btn-sm btn-outline-primary report-export-btn"
                   asp-controller="Dashboard"
                   asp-action="ExportMonthlySummaryCsv"
                   asp-route-year="@Model.SelectedYear">CSV</a>
            </div>
            <div class="card-body">
                <div class="chartjs-shell">
                    <canvas id="dashboardCashflowChart"
                            class="chartjs-canvas"
                            data-labels='@Html.Raw(trendLabels)'
                            data-income='@Html.Raw(trendIncome)'
                            data-expense='@Html.Raw(trendExpense)'
                            data-net='@Html.Raw(trendNet)'
                            data-running-balance='@Html.Raw(trendRunningBalance)'></canvas>
                </div>

                <div class="report-period-bar report-period-bar-static">
                    <p class="report-period-note mb-0">
                        @T("Biểu đồ này dùng dữ liệu xu hướng để so sánh thu và chi theo các mốc thời gian, hiển thị bằng Chart.js.",
                        "This chart uses trend data to compare income and expenses over time, rendered with Chart.js.")
                    </p>
                </div>
            </div>
        </div>

        <div class="card report-card">
            <div class="card-header d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h3 class="report-title">@T("Cơ cấu chi tiêu theo danh mục", "Expense breakdown by category")</h3>
                    <p class="report-text">@T("Cho biết tiền trong kỳ lọc đang tập trung vào nhóm nào nhiều nhất, kèm đường nối trực quan tới từng danh mục chính.", "Shows which categories take the largest share of spending in the filtered period, with visual leader lines to the main categories.")</p>
                </div>
                <a class="btn btn-sm btn-outline-primary report-export-btn"
                   asp-controller="Dashboard"
                   asp-action="ExportCategorySummaryCsv"
                   asp-route-month="@Model.SelectedMonth"
                   asp-route-year="@Model.SelectedYear">CSV</a>
            </div>
            <div class="card-body">
                @if (Model.CategoryBreakdown.Any())
                {
                    <div class="category-chart-shell">
                        <div class="chartjs-shell chartjs-shell-sm">
                            <canvas id="dashboardExpenseDonutChart"
                                    class="chartjs-canvas chartjs-canvas-sm"
                                    data-labels='@Html.Raw(donutLabels)'
                                    data-series='@Html.Raw(donutSeries)'
                                    data-colors='@Html.Raw(donutColors)'
                                    data-icons='@Html.Raw(donutIcons)'></canvas>
                        </div>
                    </div>

                    <div class="category-ring-wrap">
                        @foreach (var item in Model.CategoryBreakdown.Take(5))
                        {
                            <div class="category-ring-row">
                                <span class="category-ring-dot" style="background:@item.Color"></span>
                                <div class="category-ring-name">@item.CategoryName</div>
                                <div class="category-ring-value">@item.Percentage.ToString("0.##")%</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="category-empty">@T("Chưa có dữ liệu chi tiêu cho tháng này.", "No spending data for this month yet.")</div>
                }
            </div>
        </div>
    </div>

    <div class="report-grid" style="grid-template-columns: 1.15fr 1fr;">
        <div class="card report-card">
            <div class="card-header d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h3 class="report-title">@T("Khoản chi đáng chú ý", "Notable expenses")</h3>
                    <p class="report-text">@T("Các giao dịch chi lớn nhất trong kỳ để bạn phát hiện ngay những khoản cần xem lại.", "The largest expenses in the selected period so you can quickly review what deserves attention.")</p>
                </div>
                <a class="btn btn-sm btn-outline-primary report-export-btn"
                   asp-controller="Dashboard"
                   asp-action="ExportTopExpensesCsv"
                   asp-route-month="@Model.SelectedMonth"
                   asp-route-year="@Model.SelectedYear">CSV</a>
            </div>
            <div class="card-body">
                @if (Model.TopExpenses.Any())
                {
                    <div class="report-list">
                        @foreach (var item in Model.TopExpenses)
                        {
                            <div class="report-expense-item">
                                <div>
                                    <div class="report-expense-name">@(string.IsNullOrWhiteSpace(item.Note) ? T("Không có ghi chú", "No note") : item.Note)</div>
                                    <small class="report-expense-meta">@item.CategoryName • @item.WalletName • @item.TransactionDate.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="report-expense-amount">-@item.Amount.ToString("N0")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="report-empty">@T("Không có khoản chi nào trong kỳ đang xem.", "There are no expense records in the selected period.")</div>
                }
            </div>
        </div>

        <div class="card report-card">
            <div class="card-header">
                <h3 class="report-title">@T("Tiến độ ngân sách", "Budget progress")</h3>
                <p class="report-text">@T("Cho bạn biết danh mục nào đang gần chạm hạn mức hoặc đã vượt mức chi tiêu đã đặt trong tháng ngân sách đã chọn.", "Shows which categories are close to or over the budget limit in the selected budget month.")</p>
            </div>
            <div class="card-body">
                @if (Model.BudgetProgress.Any())
                {
                    @foreach (var item in Model.BudgetProgress)
                    {
                        var statusClass = item.Status == "over" ? "over" : item.Status == "reached" ? "reached" : "normal";
                        var statusText = item.Status == "over"
                        ? T("Vượt mức", "Over")
                        : item.Status == "reached"
                        ? T("Chạm ngưỡng", "Reached")
                        : T("Ổn", "On track");
                        var fillColor = item.Status == "over" ? "#ff5c39" : item.Status == "reached" ? "#ffb400" : "#76b947";
                        var remaining = item.RemainingAmount;
                        var progressWidth = $"{Math.Min(item.PercentageUsed, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";

                        <div class="budget-item">
                            <div class="budget-head">
                                <div class="budget-name">@item.CategoryName</div>
                                <span class="budget-status @statusClass">@statusText</span>
                            </div>
                            <div class="budget-progress-bar">
                                <div class="budget-progress-fill" style="width:@progressWidth; background:@fillColor"></div>
                            </div>
                            <div class="budget-meta">
                                <span>@item.SpentAmount.ToString("N0") / @item.LimitAmount.ToString("N0") VND</span>
                                <span>@T("Còn lại", "Remaining"): @remaining.ToString("N0") VND</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="report-empty">@T("Chưa có ngân sách nào trong tháng này.", "No budget has been created for this month yet.")</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade wallet-modal wallet-modal-unified mimo-popup" id="addWalletModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".wallet-modal-hero" data-popup-source-close=".wallet-modal-close" data-popup-title=".wallet-modal-title" data-popup-subtitle=".wallet-modal-subtitle">
    <div class="modal-dialog modal-dialog-centered modal-xl wallet-modal-dialog">
        <div class="modal-content wallet-modal-content-shell">
            <button type="button" class="wallet-modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="bx bx-x"></i>
            </button>
            <div class="wallet-modal-hero">
                <div>
                    <h4 class="wallet-modal-title">@T("Thêm ví mới", "Add new wallet")</h4>
                    <p class="wallet-modal-subtitle mb-0">@T("Tạo một ví để theo dõi tiền mặt, tài khoản ngân hàng hoặc quỹ cá nhân. Biểu mẫu được giữ gọn và đồng nhất với popup các trang khác.", "Create a wallet to track cash, bank accounts, or personal funds. The form stays compact and visually aligned with other popups.")</p>
                </div>
            </div>
            <div class="modal-body wallet-modal-body-shell">
                <div id="walletActionAlert" class="alert alert-danger d-none"></div>
                <section class="wallet-form-card">
                    <div class="wallet-form-card-head">
                        <span class="wallet-form-card-icon"><i class="bx bx-wallet"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title">@T("Thông tin ví", "Wallet information")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Nhập các thông tin cơ bản để tạo ví và thiết lập ví mặc định nếu cần.", "Enter the basic wallet details and set it as default if needed.")</p>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">@T("Tên ví", "Wallet name")</label>
                            <input type="text" id="addWalletName" class="form-control wallet-input" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                            <input type="number" id="addInitialBalance" class="form-control wallet-input" value="0" min="0" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Loại tiền", "Currency")</label>
                            <select id="addWalletCurrencyCode" class="form-select wallet-input">
                                <option value="VND">VND</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="JPY">JPY</option>
                                <option value="KRW">KRW</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="wallet-switch-card h-100">
                                <div class="form-check form-switch wallet-form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="addWalletDefault" />
                                    <label class="form-check-label" for="addWalletDefault">@T("Đặt làm ví mặc định", "Set as default wallet")</label>
                                </div>
                                <div class="wallet-switch-helper">@T("Ví này sẽ được chọn sẵn khi tạo giao dịch mới.", "This wallet will be preselected when you create a new transaction.")</div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
            <div class="modal-footer wallet-modal-footer-shell">
                <button type="button" class="btn btn-label-secondary wallet-btn-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-primary wallet-btn-primary" id="btnSaveWalletApi">@T("Lưu ví", "Save wallet")</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade wallet-modal wallet-modal-unified mimo-popup" id="walletDetailModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".wallet-modal-hero" data-popup-source-close=".wallet-modal-close" data-popup-title=".wallet-modal-title" data-popup-subtitle=".wallet-modal-subtitle" data-popup-extra=".wallet-hero-badge">
    <div class="modal-dialog modal-dialog-centered modal-xl wallet-modal-dialog">
        <div class="modal-content wallet-modal-content-shell">
            <button type="button" class="wallet-modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="bx bx-x"></i>
            </button>
            <div class="wallet-modal-hero wallet-modal-hero-with-badge">
                <div>
                    <h4 class="wallet-modal-title" id="detailWalletTitle">@T("Chi tiết ví", "Wallet details")</h4>
                    <p class="wallet-modal-subtitle mb-0"><span id="detailWalletId">-</span></p>
                </div>
                <span class="wallet-hero-badge" id="detailWalletBadge">@T("Ví thường", "Standard wallet")</span>
            </div>
            <div class="modal-body wallet-modal-body-shell">
                <div id="detailWalletActionAlert" class="alert alert-danger d-none"></div>
                <input type="hidden" id="detailWalletIdValue" />

                <section class="wallet-form-card mb-4">
                    <div class="wallet-form-card-head">
                        <span class="wallet-form-card-icon"><i class="bx bx-detail"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title">@T("Thông tin ví", "Wallet information")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Cập nhật tên ví, loại tiền, trạng thái mặc định và theo dõi số dư hiện tại của ví này.", "Update the wallet name, currency, default status, and review its current balance.")</p>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">@T("Tên ví", "Wallet name")</label>
                            <input type="text" id="detailWalletName" class="form-control wallet-input" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Loại tiền", "Currency")</label>
                            <select id="detailWalletCurrencySelect" class="form-select wallet-input">
                                <option value="VND">VND</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="JPY">JPY</option>
                                <option value="KRW">KRW</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư hiện tại", "Current balance")</label>
                            <input type="text" id="detailCurrentBalanceInput" class="form-control wallet-input" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                            <input type="text" id="detailInitialBalance" class="form-control wallet-input" readonly />
                        </div>
                        <div class="col-md-12">
                            <div class="wallet-switch-card">
                                <div class="form-check form-switch wallet-form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="detailWalletDefault" />
                                    <label class="form-check-label" for="detailWalletDefault">@T("Ví mặc định", "Default wallet")</label>
                                </div>
                                <div class="wallet-switch-helper">@T("Ví này sẽ được chọn sẵn khi tạo giao dịch mới.", "This wallet will be preselected when you create a new transaction.")</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="wallet-form-card wallet-delete-card">
                    <div class="wallet-form-card-head wallet-form-card-head-danger">
                        <span class="wallet-form-card-icon wallet-form-card-icon-danger"><i class="bx bx-trash"></i></span>
                        <div>
                            <h5 class="wallet-form-card-title text-danger">@T("Xóa ví", "Delete wallet")</h5>
                            <p class="wallet-form-card-text mb-0">@T("Chọn cách xử lý các giao dịch liên quan trước khi xóa ví này.", "Choose how related transactions should be handled before deleting this wallet.")</p>
                        </div>
                    </div>
                    <div class="wallet-delete-options">
                        <label class="wallet-radio-card">
                            <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeDeleteAll" value="delete_all" checked />
                            <span>
                                <strong>@T("Xóa ví và các giao dịch liên quan", "Delete wallet and related transactions")</strong>
                                <small>@T("Phù hợp khi ví này không còn cần lưu lịch sử.", "Use this when the wallet history is no longer needed.")</small>
                            </span>
                        </label>
                        <label class="wallet-radio-card">
                            <input class="form-check-input" type="radio" name="deleteWalletMode" id="deleteWalletModeMove" value="move_transactions" />
                            <span>
                                <strong>@T("Chuyển giao dịch sang ví khác", "Move transactions to another wallet")</strong>
                                <small>@T("Giữ lại lịch sử giao dịch bằng cách chuyển sang ví thay thế.", "Keep the transaction history by moving it to a replacement wallet.")</small>
                            </span>
                        </label>
                    </div>
                    <div id="replacementWalletGroup" class="d-none mt-3">
                        <label class="form-label">@T("Ví nhận giao dịch", "Replacement wallet")</label>
                        <select id="replacementWalletId" class="form-select wallet-input">
                            <option value="">@T("Chọn ví", "Select wallet")</option>
                            @foreach (var wallet in orderedWallets)
                            {
                                <option value="@wallet.WalletId">@wallet.WalletName</option>
                            }
                        </select>
                    </div>
                </section>
            </div>
            <div class="modal-footer wallet-modal-footer-shell wallet-modal-footer-shell-split">
                <button type="button" class="btn btn-danger wallet-btn-danger" id="btnDeleteWalletApi">@T("Xóa ví", "Delete wallet")</button>
                <div class="wallet-footer-actions">
                    <button type="button" class="btn btn-label-secondary wallet-btn-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                    <button type="button" class="btn btn-primary wallet-btn-primary" id="btnUpdateWalletApi">@T("Lưu thay đổi", "Save changes")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade wallet-confirm-modal" id="walletDeleteConfirmModal" tabindex="-1" aria-hidden="true" data-popup-base="true" data-popup-source-header=".modal-header" data-popup-title=".modal-title" data-popup-head-compact="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">@T("Xác nhận xóa ví", "Confirm wallet deletion")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-0 text-body-secondary">@T("Bạn có chắc muốn xóa ví này không? Hành động này có thể ảnh hưởng đến giao dịch liên quan.", "Are you sure you want to delete this wallet? This action can affect related transactions.")</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteWallet">@T("Xóa ví", "Delete wallet")</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/sneat/js/pages/wallet-dashboard.js"></script>
}