@using System.IO
@using System.Linq
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewBag.Title = "Wallet Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();

    string T(string vi, string en) => lang == "en" ? en : vi;

    var currencyOptions = new[]
    {
        new { Code = "VND", NameVi = "Việt Nam Đồng", NameEn = "Vietnamese Dong", Flag = "/sneat/img/icons/currencies/vietnam.png" },
        new { Code = "USD", NameVi = "Đô la Mỹ", NameEn = "US Dollar", Flag = "/sneat/img/icons/currencies/united-states.png" },
        new { Code = "EUR", NameVi = "Euro", NameEn = "Euro", Flag = "/sneat/img/icons/currencies/european-union.png" },
        new { Code = "JPY", NameVi = "Yên Nhật", NameEn = "Japanese Yen", Flag = "/sneat/img/icons/currencies/japan.png" },
        new { Code = "KRW", NameVi = "Won Hàn", NameEn = "Korean Won", Flag = "/sneat/img/icons/currencies/south-korea.png" }
    };

    var walletIconFolderPhysical = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "sneat", "img", "icons", "wallets");
    var walletIconFiles = Directory.Exists(walletIconFolderPhysical)
        ? Directory.GetFiles(walletIconFolderPhysical)
            .Where(f =>
            {
                var ext = System.IO.Path.GetExtension(f).ToLower();
                return ext == ".png" || ext == ".svg" || ext == ".webp" || ext == ".jpg" || ext == ".jpeg";
            })
            .Select(System.IO.Path.GetFileName)
            .OrderBy(x => x)
            .ToList()
        : new List<string>();

    var presetColors = new[]
    {
        "#FFAB00",
        "#696CFF",
        "#03C3EC",
        "#71DD37",
        "#FF3E1D",
        "#8592A3",
        "#233446",
        "#8C57FF"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/wallet-dashboard.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="mb-1">@T("Danh sách ví", "Wallet List")</h5>
                <p class="card-subtitle mb-0">
                    @T("Chọn một ví để xem, sửa hoặc xóa.", "Click a wallet to view, edit, or delete.")
                </p>
            </div>

            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addWalletModal">
                <i class="icon-base bx bx-plus me-1"></i> @T("Thêm ví mới", "Add New Wallet")
            </button>
        </div>

        <div class="card-body">
            <div class="row g-4 wallet-grid">

                <div class="col-12 col-md-6 col-xl-4 col-wallet">
                    <button type="button"
                            class="card wallet-card-static text-start"
                            data-bs-toggle="modal"
                            data-bs-target="#walletDetailModal"
                            data-wallet-id="W00010001"
                            data-wallet-name="Tiền mặt"
                            data-wallet-balance="1250000"
                            data-wallet-initial="500000"
                            data-wallet-currency="VND"
                            data-wallet-color="#FFAB00"
                            data-wallet-icon="/sneat/img/icons/wallets/@(walletIconFiles.Count > 0 ? walletIconFiles[0] : "")">
                        <div class="card-body">
                            <div class="wallet-card-mini">
                                <div class="wallet-card-mini-left">
                                    <div class="wallet-image-box" style="background: rgba(255,171,0,.14);">
                                        @if (walletIconFiles.Count > 0)
                                        {
                                            <img src="~/sneat/img/icons/wallets/@walletIconFiles[0]" alt="wallet icon" class="wallet-image-icon" />
                                        }
                                    </div>
                                    <div>
                                        <div class="wallet-name">Tiền mặt</div>
                                        <div class="wallet-mini-type">@T("Tiền mặt", "Cash")</div>
                                    </div>
                                </div>
                                <div class="wallet-card-mini-right">
                                    <div class="wallet-balance-compact">1,250,000 VND</div>
                                </div>
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-12 col-md-6 col-xl-4 col-wallet">
                    <button type="button"
                            class="card wallet-card-static text-start"
                            data-bs-toggle="modal"
                            data-bs-target="#walletDetailModal"
                            data-wallet-id="W00010002"
                            data-wallet-name="Ngân hàng MB"
                            data-wallet-balance="8750000"
                            data-wallet-initial="3000000"
                            data-wallet-currency="VND"
                            data-wallet-color="#696CFF"
                            data-wallet-icon="/sneat/img/icons/wallets/@(walletIconFiles.Count > 1 ? walletIconFiles[1] : (walletIconFiles.Count > 0 ? walletIconFiles[0] : ""))">
                        <div class="card-body">
                            <div class="wallet-card-mini">
                                <div class="wallet-card-mini-left">
                                    <div class="wallet-image-box" style="background: rgba(105,108,255,.14);">
                                        @if (walletIconFiles.Count > 1)
                                        {
                                            <img src="~/sneat/img/icons/wallets/@walletIconFiles[1]" alt="wallet icon" class="wallet-image-icon" />
                                        }
                                        else if (walletIconFiles.Count > 0)
                                        {
                                            <img src="~/sneat/img/icons/wallets/@walletIconFiles[0]" alt="wallet icon" class="wallet-image-icon" />
                                        }
                                    </div>
                                    <div>
                                        <div class="wallet-name">Ngân hàng MB</div>
                                        <div class="wallet-mini-type">@T("Ngân hàng", "Bank")</div>
                                    </div>
                                </div>
                                <div class="wallet-card-mini-right">
                                    <div class="wallet-balance-compact">8,750,000 VND</div>
                                </div>
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-12 col-md-6 col-xl-4 col-wallet">
                    <button type="button"
                            class="card wallet-card-static text-start"
                            data-bs-toggle="modal"
                            data-bs-target="#walletDetailModal"
                            data-wallet-id="W00010003"
                            data-wallet-name="Quỹ du lịch"
                            data-wallet-balance="4200"
                            data-wallet-initial="2000"
                            data-wallet-currency="USD"
                            data-wallet-color="#03C3EC"
                            data-wallet-icon="/sneat/img/icons/wallets/@(walletIconFiles.Count > 2 ? walletIconFiles[2] : (walletIconFiles.Count > 0 ? walletIconFiles[0] : ""))">
                        <div class="card-body">
                            <div class="wallet-card-mini">
                                <div class="wallet-card-mini-left">
                                    <div class="wallet-image-box" style="background: rgba(3,195,236,.14);">
                                        @if (walletIconFiles.Count > 2)
                                        {
                                            <img src="~/sneat/img/icons/wallets/@walletIconFiles[2]" alt="wallet icon" class="wallet-image-icon" />
                                        }
                                        else if (walletIconFiles.Count > 0)
                                        {
                                            <img src="~/sneat/img/icons/wallets/@walletIconFiles[0]" alt="wallet icon" class="wallet-image-icon" />
                                        }
                                    </div>
                                    <div>
                                        <div class="wallet-name">Quỹ du lịch</div>
                                        <div class="wallet-mini-type">@T("Tiết kiệm", "Saving")</div>
                                    </div>
                                </div>
                                <div class="wallet-card-mini-right">
                                    <div class="wallet-balance-compact">4,200 USD</div>
                                </div>
                            </div>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="container-xxl flex-grow-1 container-p-y pt-0 dashboard-report-section">
    <div class="row g-4">

        <div class="col-12">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-1">
                <div>
                    <h5 class="mb-1">@T("Tổng quan tài chính", "Financial Overview")</h5>
                    <p class="text-body-secondary mb-0">
                        @T("Theo dõi nhanh thu chi, cơ cấu chi tiêu và tiến độ tài chính hiện tại.", "Track income, expense, spending structure and current financial progress.")
                    </p>
                </div>

                <div class="dashboard-report-filter-chip">
                    <i class="bx bx-calendar me-1"></i>
                    @T("Tháng này", "This month")
                </div>
            </div>
        </div>

        <!-- KPI -->
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-report-kpi dashboard-report-kpi-success">
                <div class="card-body">
                    <div class="dashboard-report-kpi-top">
                        <span class="dashboard-report-kpi-icon">
                            <i class="bx bx-trending-up"></i>
                        </span>
                    </div>
                    <div class="dashboard-report-kpi-label">@T("Tổng thu", "Total Income")</div>
                    <h5 class="mb-1">18,000,000 VND</h5>
                    <small>@T("Cập nhật theo kỳ đang chọn", "Based on current filter")</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-report-kpi dashboard-report-kpi-danger">
                <div class="card-body">
                    <div class="dashboard-report-kpi-top">
                        <span class="dashboard-report-kpi-icon">
                            <i class="bx bx-trending-down"></i>
                        </span>
                    </div>
                    <div class="dashboard-report-kpi-label">@T("Tổng chi", "Total Expense")</div>
                    <h5 class="mb-1">4,982,000 VND</h5>
                    <small>@T("Chi tiêu trong kỳ", "Spending in current period")</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-report-kpi dashboard-report-kpi-primary">
                <div class="card-body">
                    <div class="dashboard-report-kpi-top">
                        <span class="dashboard-report-kpi-icon">
                            <i class="bx bx-bar-chart-alt-2"></i>
                        </span>
                    </div>
                    <div class="dashboard-report-kpi-label">@T("Chênh lệch", "Net Cashflow")</div>
                    <h5 class="mb-1">+13,018,000 VND</h5>
                    <small>@T("Thu trừ chi", "Income minus expense")</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-report-kpi dashboard-report-kpi-warning">
                <div class="card-body">
                    <div class="dashboard-report-kpi-top">
                        <span class="dashboard-report-kpi-icon">
                            <i class="bx bx-receipt"></i>
                        </span>
                    </div>
                    <div class="dashboard-report-kpi-label">@T("Số giao dịch", "Transactions")</div>
                    <h5 class="mb-1">24</h5>
                    <small>@T("Trong tháng hiện tại", "In current month")</small>
                </div>
            </div>
        </div>

        <!-- Line chart -->
        <div class="col-12 col-xl-8">
            <div class="card dashboard-report-card h-100">
                <div class="card-header border-0 pb-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <div>
                        <h6 class="mb-1">@T("Xu hướng thu chi", "Income & Expense Trend")</h6>
                        <small class="text-body-secondary">
                            @T("Theo dõi biến động thu và chi theo từng tháng.", "Track income and expense over time.")
                        </small>
                    </div>

                    <div class="dashboard-report-legend">
                        <span><i class="legend-dot legend-income"></i> @T("Thu", "Income")</span>
                        <span><i class="legend-dot legend-expense"></i> @T("Chi", "Expense")</span>
                    </div>
                </div>

                <div class="card-body">
                    <div id="dashboardCashflowChart" class="dashboard-report-chart-lg"></div>
                </div>
            </div>
        </div>

        <!-- Donut chart -->
        <div class="col-12 col-xl-4">
            <div class="card dashboard-report-card h-100">
                <div class="card-header border-0 pb-0">
                    <h6 class="mb-1">@T("Cơ cấu chi tiêu", "Expense Breakdown")</h6>
                    <small class="text-body-secondary">
                        @T("Phân bổ chi tiêu theo danh mục trong kỳ.", "Expense distribution by category.")
                    </small>
                </div>

                <div class="card-body">
                    <div id="dashboardExpenseDonutChart" class="dashboard-report-chart-donut mb-3"></div>

                    <div class="dashboard-category-list">
                        <div class="dashboard-category-item">
                            <div class="dashboard-category-left">
                                <span class="dashboard-category-dot shopping"></span>
                                <span>@T("Mua sắm", "Shopping")</span>
                            </div>
                            <strong>34%</strong>
                        </div>

                        <div class="dashboard-category-item">
                            <div class="dashboard-category-left">
                                <span class="dashboard-category-dot food"></span>
                                <span>@T("Ăn uống", "Food")</span>
                            </div>
                            <strong>24%</strong>
                        </div>

                        <div class="dashboard-category-item">
                            <div class="dashboard-category-left">
                                <span class="dashboard-category-dot bills"></span>
                                <span>@T("Hóa đơn", "Bills")</span>
                            </div>
                            <strong>18%</strong>
                        </div>

                        <div class="dashboard-category-item">
                            <div class="dashboard-category-left">
                                <span class="dashboard-category-dot transport"></span>
                                <span>@T("Di chuyển", "Transport")</span>
                            </div>
                            <strong>14%</strong>
                        </div>

                        <div class="dashboard-category-item">
                            <div class="dashboard-category-left">
                                <span class="dashboard-category-dot other"></span>
                                <span>@T("Khác", "Other")</span>
                            </div>
                            <strong>10%</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top expenses -->
        <div class="col-12 col-xl-6">
            <div class="card dashboard-report-card h-100">
                <div class="card-header border-0 pb-0">
                    <h6 class="mb-1">@T("Chi tiêu nổi bật", "Top Expenses")</h6>
                    <small class="text-body-secondary">
                        @T("Các khoản chi lớn nhất trong kỳ đang chọn.", "Largest expenses in selected period.")
                    </small>
                </div>

                <div class="card-body">
                    <div class="dashboard-top-expense-list">
                        <div class="dashboard-top-expense-item">
                            <div>
                                <div class="fw-semibold">@T("Mua bàn phím", "Keyboard purchase")</div>
                                <small class="text-body-secondary">@T("Mua sắm • Thẻ Visa", "Shopping • Visa Card")</small>
                            </div>
                            <strong class="text-danger">-1,250,000</strong>
                        </div>

                        <div class="dashboard-top-expense-item">
                            <div>
                                <div class="fw-semibold">Netflix</div>
                                <small class="text-body-secondary">@T("Hóa đơn • Thẻ Visa", "Bills • Visa Card")</small>
                            </div>
                            <strong class="text-danger">-260,000</strong>
                        </div>

                        <div class="dashboard-top-expense-item">
                            <div>
                                <div class="fw-semibold">@T("Ăn trưa cùng nhóm", "Lunch with team")</div>
                                <small class="text-body-secondary">@T("Ăn uống • Ví tiền mặt", "Food • Cash Wallet")</small>
                            </div>
                            <strong class="text-danger">-120,000</strong>
                        </div>

                        <div class="dashboard-top-expense-item">
                            <div>
                                <div class="fw-semibold">@T("Grab đi làm", "Commute by Grab")</div>
                                <small class="text-body-secondary">@T("Di chuyển • Ví tiền mặt", "Transport • Cash Wallet")</small>
                            </div>
                            <strong class="text-danger">-42,000</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Saving goal -->
        <div class="col-12 col-xl-6">
            <div class="card dashboard-report-card h-100">
                <div class="card-header border-0 pb-0">
                    <h6 class="mb-1">@T("Tiến độ mục tiêu", "Goal Progress")</h6>
                    <small class="text-body-secondary">
                        @T("Theo dõi tiến độ tiết kiệm hoặc ngân sách hiện tại.", "Track your current saving or budget goal.")
                    </small>
                </div>

                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-5">
                            <div id="dashboardSavingGoalChart" class="dashboard-report-chart-radial"></div>
                        </div>
                        <div class="col-md-7">
                            <div class="dashboard-goal-list">
                                <div class="dashboard-goal-item">
                                    <span>@T("Mục tiêu", "Goal")</span>
                                    <strong>10,000,000 VND</strong>
                                </div>
                                <div class="dashboard-goal-item">
                                    <span>@T("Đã đạt", "Achieved")</span>
                                    <strong>7,200,000 VND</strong>
                                </div>
                                <div class="dashboard-goal-item">
                                    <span>@T("Còn thiếu", "Remaining")</span>
                                    <strong class="text-warning">2,800,000 VND</strong>
                                </div>
                                <div class="dashboard-goal-item">
                                    <span>@T("Tỷ lệ hoàn thành", "Completion")</span>
                                    <strong class="text-primary">72%</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Add Wallet Modal -->
<div class="modal fade wallet-modal" id="addWalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg wallet-modal-smaller">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h4 class="modal-title mb-1">@T("Thêm ví mới", "Add New Wallet")</h4>
                    <p class="text-body-secondary mb-0">@T("Tạo nhanh một ví mới.", "Create a new wallet quickly.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên ví", "Wallet name")</label>
                        <input type="text" id="addWalletName" class="form-control" value="Tiền mặt" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                        <input type="number" id="addInitialBalance" class="form-control" value="0" min="0" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Loại tiền", "Currency")</label>
                        <div class="dropdown w-100">
                            <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-between wallet-currency-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <span class="d-flex align-items-center gap-2">
                                    <img id="addWalletCurrencyFlag" class="wallet-dropdown-flag" src="@currencyOptions[0].Flag" alt="VND" />
                                    <span id="addWalletCurrencyLabel">@currencyOptions[0].NameVi (VND)</span>
                                </span>
                                <i class="icon-base bx bx-chevron-down"></i>
                            </button>

                            <ul class="dropdown-menu wallet-dropdown-menu">
                                @foreach (var currency in currencyOptions)
                                {
                                    <li>
                                        <a href="#"
                                           class="wallet-currency-option"
                                           data-code="@currency.Code"
                                           data-name="@(lang == "en" ? currency.NameEn : currency.NameVi)"
                                           data-flag="@currency.Flag">
                                            <img class="wallet-dropdown-flag" src="@currency.Flag" alt="@currency.Code" />
                                            <span class="wallet-currency-meta">
                                                <strong>@(lang == "en" ? currency.NameEn : currency.NameVi)</strong>
                                                <small>@currency.Code</small>
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <input type="hidden" id="addWalletCurrencyCode" value="VND" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Màu ví", "Wallet color")</label>

                        <div class="wallet-color-tools">
                            <div class="wallet-color-presets">
                                @foreach (var color in presetColors)
                                {
                                    <button type="button"
                                            class="wallet-color-preset @(color == "#FFAB00" ? "active" : "")"
                                            data-color="@color"
                                            style="background:@color;">
                                    </button>
                                }
                            </div>

                            <div class="wallet-color-custom">
                                <input type="color" id="addWalletColor" class="form-control form-control-color" value="#FFAB00" />
                                <span class="wallet-color-code" id="addWalletColorCode">#FFAB00</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@T("Icon ví", "Wallet icon")</label>

                        <div class="wallet-image-picker">
                            @if (walletIconFiles.Any())
                            {
                                for (int i = 0; i < walletIconFiles.Count; i++)
                                {
                                    var fileName = walletIconFiles[i];
                                    <button type="button"
                                            class="wallet-image-option wallet-image-option-add @(i == 0 ? "active" : "")"
                                            data-icon="/sneat/img/icons/wallets/@fileName">
                                        <img src="~/sneat/img/icons/wallets/@fileName" alt="@fileName" />
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="text-muted small">@T("Chưa có icon trong thư mục wallets.", "No wallet icons found in wallets folder.")</div>
                            }
                        </div>
                        <input type="hidden" id="addWalletIcon" value="@(walletIconFiles.Any() ? $"/sneat/img/icons/wallets/{walletIconFiles.First()}" : "")" />
                    </div>

                    <div class="col-12">
                        <div class="wallet-preview-inline card">
                            <div class="card-body">
                                <div class="wallet-card-mini">
                                    <div class="wallet-card-mini-left">
                                        <div id="addPreviewIconWrap" class="wallet-image-box" style="background: rgba(255,171,0,.14);">
                                            @if (walletIconFiles.Any())
                                            {
                                                <img id="addPreviewIcon" src="~/sneat/img/icons/wallets/@walletIconFiles.First()" alt="icon" class="wallet-image-icon" />
                                            }
                                            else
                                            {
                                                <img id="addPreviewIcon" src="" alt="icon" class="wallet-image-icon d-none" />
                                            }
                                        </div>
                                        <div>
                                            <div class="wallet-name" id="addPreviewName">Tiền mặt</div>
                                            <div class="wallet-mini-type" id="addPreviewCurrencyBadge">VND</div>
                                        </div>
                                    </div>
                                    <div class="wallet-card-mini-right">
                                        <div class="wallet-balance-compact" id="addPreviewBalance">0 VND</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="addWalletDefault" checked />
                            <label class="form-check-label" for="addWalletDefault">@T("Đặt làm ví mặc định", "Set as default wallet")</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-primary" id="btnSaveWalletStatic">@T("Lưu ví", "Save Wallet")</button>
            </div>
        </div>
    </div>
</div>

<!-- Detail Wallet Modal -->
<div class="modal fade wallet-modal" id="walletDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg wallet-modal-smaller">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h4 class="modal-title mb-1">@T("Chi tiết ví", "Wallet Details")</h4>
                    <p class="text-body-secondary mb-0">@T("Xem và chỉnh sửa nhanh thông tin ví.", "Quickly view and edit wallet info.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="wallet-detail-top card">
                    <div class="card-body">
                        <div class="wallet-card-mini">
                            <div class="wallet-card-mini-left">
                                <div id="detailHeadIconWrap" class="wallet-image-box" style="background: rgba(255,171,0,.14);">
                                    <img id="detailHeadIcon" src="" alt="wallet icon" class="wallet-image-icon" />
                                </div>
                                <div>
                                    <div class="wallet-name" id="detailWalletTitle">Tiền mặt</div>
                                    <div class="wallet-mini-type">
                                        <span class="badge bg-label-primary me-1" id="detailWalletId">W00010001</span>
                                        <span class="badge bg-label-success" id="detailWalletCurrency">VND</span>
                                    </div>
                                </div>
                            </div>
                            <div class="wallet-card-mini-right">
                                <div class="wallet-balance-compact" id="detailCurrentBalance">1,250,000 VND</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mt-1">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên ví", "Wallet name")</label>
                        <input type="text" id="detailWalletName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Số dư ban đầu", "Initial balance")</label>
                        <input type="number" id="detailInitialBalance" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Màu ví", "Wallet color")</label>
                        <div class="wallet-color-tools">
                            <div class="wallet-color-presets">
                                @foreach (var color in presetColors)
                                {
                                    <button type="button"
                                            class="wallet-color-preset-detail @(color == "#FFAB00" ? "active" : "")"
                                            data-color="@color"
                                            style="background:@color;">
                                    </button>
                                }
                            </div>

                            <div class="wallet-color-custom">
                                <input type="color" id="detailWalletColor" class="form-control form-control-color" value="#FFAB00" />
                                <span class="wallet-color-code" id="detailWalletColorCode">#FFAB00</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@T("Icon ví", "Wallet icon")</label>
                        <div class="wallet-image-picker wallet-image-picker-detail">
                            @if (walletIconFiles.Any())
                            {
                                for (int i = 0; i < walletIconFiles.Count; i++)
                                {
                                    var fileName = walletIconFiles[i];
                                    <button type="button"
                                            class="wallet-image-option wallet-image-option-detail @(i == 0 ? "active" : "")"
                                            data-icon="/sneat/img/icons/wallets/@fileName">
                                        <img src="~/sneat/img/icons/wallets/@fileName" alt="@fileName" />
                                    </button>
                                }
                            }
                        </div>
                        <input type="hidden" id="detailWalletIcon" value="@(walletIconFiles.Any() ? $"/sneat/img/icons/wallets/{walletIconFiles.First()}" : "")" />
                    </div>

                    <div class="col-12">
                        <div class="wallet-preview-inline card">
                            <div class="card-body">
                                <div class="wallet-card-mini">
                                    <div class="wallet-card-mini-left">
                                        <div id="detailPreviewIconWrap" class="wallet-image-box" style="background: rgba(255,171,0,.14);">
                                            <img id="detailPreviewIcon" src="" alt="icon" class="wallet-image-icon" />
                                        </div>
                                        <div>
                                            <div class="wallet-name" id="detailPreviewName">Tiền mặt</div>
                                            <div class="wallet-mini-type" id="detailPreviewCurrency">VND</div>
                                        </div>
                                    </div>
                                    <div class="wallet-card-mini-right">
                                        <div class="wallet-balance-compact" id="detailPreviewBalance">500,000 VND</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-warning mb-0">
                            <i class="icon-base bx bx-info-circle me-1"></i>
                            @T("Đây là giao diện tĩnh. Nút lưu/xóa hiện chỉ hiển thị thông báo.", "This is a static UI. Save/Delete currently show toast only.")
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteWalletStatic">
                    <i class="icon-base bx bx-trash me-1"></i> @T("Xóa ví", "Delete Wallet")
                </button>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                    <button type="button" class="btn btn-primary" id="btnUpdateWalletStatic">
                        <i class="icon-base bx bx-save me-1"></i> @T("Lưu thay đổi", "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Toast -->
<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-4 wallet-toast-stack">
    <div id="walletSavedToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="icon-base bx bx-check-circle me-2"></i>
            <strong class="me-auto">@T("Ví", "Wallet")</strong>
            <small>@T("Vừa xong", "Now")</small>
            <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            @T("Lưu ví thành công.", "Wallet saved successfully.")
        </div>
    </div>

    <div id="walletUpdatedToast" class="toast bg-primary text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-primary text-white">
            <i class="icon-base bx bx-edit me-2"></i>
            <strong class="me-auto">@T("Ví", "Wallet")</strong>
            <small>@T("Vừa xong", "Now")</small>
            <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            @T("Cập nhật ví thành công.", "Wallet updated successfully.")
        </div>
    </div>

    <div id="walletDeletedToast" class="toast bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-danger text-white">
            <i class="icon-base bx bx-trash me-2"></i>
            <strong class="me-auto">@T("Ví", "Wallet")</strong>
            <small>@T("Vừa xong", "Now")</small>
            <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            @T("Xóa ví thành công.", "Wallet deleted successfully.")
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/sneat/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="~/sneat/js/pages/wallet-dashboard.js"></script>
}