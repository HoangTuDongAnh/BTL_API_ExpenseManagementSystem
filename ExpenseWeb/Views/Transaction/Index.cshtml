@model ExpenseWeb.Models.ViewModels.Transaction.TransactionPageViewModel
@using System.Globalization
@{
    ViewBag.Title = "Giao dịch";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string GetMainText(ExpenseWeb.Models.ViewModels.Transaction.TransactionItemViewModel item)
        => string.IsNullOrWhiteSpace(item.Note) ? "Không có ghi chú" : item.Note;
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/transaction-page.css" />
}

<div class="container-xxl flex-grow-1 container-p-y transaction-page">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="row g-4 mb-4 transaction-summary-row">
        <div class="col-md-6">
            <div class="card transaction-summary-card h-100">
                <div class="card-body">
                    <div class="transaction-summary-wrap">
                        <div class="transaction-donut donut-income" id="incomeDonut">
                            <div class="transaction-donut-inner">
                                <span>Thu nhập</span>
                                <strong id="incomeDonutTotal">0 VND</strong>
                            </div>
                        </div>
                        <div class="transaction-summary-content">
                            <div class="transaction-summary-head">
                                <h5 class="mb-1">Cơ cấu thu nhập</h5>
                                <small class="text-body-secondary">Theo tập giao dịch đang hiển thị</small>
                            </div>
                            <div class="transaction-summary-legend" id="incomeLegend"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card transaction-summary-card h-100">
                <div class="card-body">
                    <div class="transaction-summary-wrap">
                        <div class="transaction-donut donut-expense" id="expenseDonut">
                            <div class="transaction-donut-inner">
                                <span>Chi tiêu</span>
                                <strong id="expenseDonutTotal">0 VND</strong>
                            </div>
                        </div>
                        <div class="transaction-summary-content">
                            <div class="transaction-summary-head">
                                <h5 class="mb-1">Cơ cấu chi tiêu</h5>
                                <small class="text-body-secondary">Theo tập giao dịch đang hiển thị</small>
                            </div>
                            <div class="transaction-summary-legend" id="expenseLegend"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card transaction-toolbar-card mb-4">
        <div class="card-body">
            <div class="transaction-toolbar-grid">
                <div class="transaction-toolbar-primary">
                    <button type="button" class="btn btn-primary transaction-add-btn" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
                        <i class="bx bx-plus me-1"></i> Thêm giao dịch mới
                    </button>

                    <div class="transaction-segmented" id="transactionTypeTabs">
                        <button type="button" class="active" data-type="all">Tất cả</button>
                        <button type="button" data-type="expense">Chi tiêu</button>
                        <button type="button" data-type="income">Thu nhập</button>
                    </div>
                </div>

                <div class="transaction-toolbar-search">
                    <label class="transaction-field-label">Tìm kiếm</label>
                    <div class="transaction-searchbox">
                        <i class="bx bx-search"></i>
                        <input type="text" id="transactionSearchInput" placeholder="Tìm theo ghi chú, danh mục, ví..." />
                    </div>
                </div>

                <div class="transaction-toolbar-filter">
                    <label class="transaction-field-label">Ví</label>
                    <select class="form-select" id="walletFilter">
                        <option value="all">Tất cả ví</option>
                        @foreach (var wallet in Model.Wallets)
                        {
                            <option value="@wallet.wallet_name">@wallet.wallet_name</option>
                        }
                    </select>
                </div>

                <div class="transaction-toolbar-filter">
                    <label class="transaction-field-label">Khoảng thời gian</label>
                    <select class="form-select" id="periodFilter">
                        <option value="today">Hôm nay</option>
                        <option value="week">7 ngày gần nhất</option>
                        <option value="month" selected>Tháng gần nhất có dữ liệu</option>
                        <option value="custom">Tùy chọn</option>
                    </select>
                </div>

                <div class="transaction-toolbar-filter d-none" id="fromDateWrap">
                    <label class="transaction-field-label">Từ ngày</label>
                    <input type="date" class="form-control" id="fromDateFilter" />
                </div>

                <div class="transaction-toolbar-filter d-none" id="toDateWrap">
                    <label class="transaction-field-label">Đến ngày</label>
                    <input type="date" class="form-control" id="toDateFilter" />
                </div>

                <div class="transaction-toolbar-action">
                    <button type="button" class="btn btn-outline-secondary w-100 transaction-export-btn">
                        <i class="bx bx-download me-1"></i> Xuất dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card transaction-list-card mb-4">
        <div class="card-header border-0 pb-0">
            <div class="transaction-section-head">
                <div>
                    <h5 class="mb-1">Danh sách giao dịch</h5>
                    <small class="text-body-secondary">Hiển thị các giao dịch sau khi áp dụng bộ lọc, có phân trang để dễ theo dõi.</small>
                </div>
                <div class="transaction-section-meta">
                    <span class="badge bg-label-primary" id="transactionCountBadge">0 giao dịch</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive" id="transactionTableWrapper">
                <table class="table align-middle transaction-table">
                    <thead>
                        <tr>
                            <th>Giao dịch</th>
                            <th>Danh mục</th>
                            <th>Ví</th>
                            <th>Ngày</th>
                            <th>Số tiền</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="transactionTableBody">
                        @foreach (var item in Model.Transactions)
                        {
                            var amountClass = item.TransactionType == "income" ? "text-success" : "text-danger";
                            var mainText = GetMainText(item);
                            <tr class="transaction-row"
                                data-id="@item.TransactionId"
                                data-note="@mainText"
                                data-category="@item.CategoryName"
                                data-category-icon="@item.CategoryIcon"
                                data-category-color="@item.CategoryColor"
                                data-wallet="@item.WalletName"
                                data-wallet-id="@item.WalletId"
                                data-category-id="@item.CategoryId"
                                data-type="@item.TransactionType"
                                data-amount="@item.AmountText"
                                data-amount-value="@item.AmountValue.ToString(CultureInfo.InvariantCulture)"
                                data-date="@item.TransactionDateText"
                                data-iso-date="@item.TransactionDate.ToString("yyyy-MM-dd")"
                                data-badge="@item.RecurringBadgeText"
                                data-currency="@item.Currency">
                                <td>
                                    <div class="transaction-main-info">
                                        <div class="transaction-icon-box" style="background:@($"{item.CategoryColor}18"); color:@item.CategoryColor;">
                                            <i class="@item.CategoryIcon"></i>
                                        </div>
                                        <div class="transaction-main-text">
                                            <h6 class="mb-0">@mainText</h6>
                                            <small class="text-body-secondary">Mã: @item.TransactionId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="transaction-category-pill" style="background:@($"{item.CategoryColor}14"); color:@item.CategoryColor;">
                                        <i class="@item.CategoryIcon"></i>
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>@item.WalletName</td>
                                <td>
                                    <div class="transaction-date-cell">
                                        <span>@item.TransactionDateText</span>
                                        <small class="text-body-secondary">@item.RecurringBadgeText</small>
                                    </div>
                                </td>
                                <td class="@amountClass fw-semibold">@item.AmountText</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-outline-primary transaction-detail-trigger"
                                            data-id="@item.TransactionId"
                                            data-note="@mainText"
                                            data-category="@item.CategoryName"
                                            data-category-icon="@item.CategoryIcon"
                                            data-category-color="@item.CategoryColor"
                                            data-wallet="@item.WalletName"
                                            data-wallet-id="@item.WalletId"
                                            data-category-id="@item.CategoryId"
                                            data-type="@item.TransactionType"
                                            data-amount="@item.AmountText"
                                            data-amount-value="@item.AmountValue.ToString(CultureInfo.InvariantCulture)"
                                            data-date="@item.TransactionDateText"
                                            data-iso-date="@item.TransactionDate.ToString("yyyy-MM-dd")"
                                            data-badge="@item.RecurringBadgeText"
                                            data-currency="@item.Currency">
                                        <i class="bx bx-show"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="transaction-empty-state" id="transactionEmptyState">
                <div class="transaction-empty-icon"><i class="bx bx-folder-open"></i></div>
                <h6 class="mb-1">Không có giao dịch phù hợp</h6>
                <p class="mb-0 text-body-secondary">Hãy thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
            </div>

            <div class="transaction-pagination" id="transactionPagination"></div>
        </div>
    </div>

    <div class="card transaction-calendar-card">
        <div class="card-header border-0 pb-0">
            <div class="transaction-section-head transaction-calendar-top">
                <div>
                    <h5 class="mb-1">Lịch giao dịch</h5>
                    <small class="text-body-secondary">Mỗi ngày hiển thị số lượng giao dịch và tổng quan nhanh. Bấm vào ô ngày để xem chi tiết.</small>
                </div>
                <div class="transaction-calendar-top-right">
                    <div class="transaction-calendar-legend">
                        <span><i class="legend-dot income"></i> Có thu nhập</span>
                        <span><i class="legend-dot expense"></i> Có chi tiêu</span>
                        <span><i class="legend-dot mix"></i> Có cả hai</span>
                    </div>
                    <div class="transaction-calendar-nav">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="calendarPrevBtn"><i class="bx bx-chevron-left"></i></button>
                        <div class="transaction-calendar-title" id="calendarTitle">Tháng</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="calendarNextBtn"><i class="bx bx-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="transaction-mini-calendar">
                <div class="transaction-mini-calendar-weekdays">
                    <span>CN</span><span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span>
                </div>
                <div class="transaction-mini-calendar-grid" id="transactionMiniCalendarGrid"></div>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end transaction-day-offcanvas" tabindex="-1" id="transactionDayOffcanvas">
    <div class="offcanvas-header border-0">
        <div>
            <h5 class="offcanvas-title mb-1" id="transactionDayTitle">Chi tiết trong ngày</h5>
            <small class="text-body-secondary" id="transactionDaySubTitle">Tổng hợp giao dịch theo ngày</small>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="transaction-day-stats">
            <div class="transaction-day-stat"><span>Số giao dịch</span><strong id="dayStatCount">0</strong></div>
            <div class="transaction-day-stat income"><span>Thu nhập</span><strong id="dayStatIncome">0 VND</strong></div>
            <div class="transaction-day-stat expense"><span>Chi tiêu</span><strong id="dayStatExpense">0 VND</strong></div>
        </div>
        <div class="transaction-day-list" id="transactionDayList"></div>
    </div>
</div>

<div class="modal fade transaction-modal" id="transactionDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title">Chi tiết giao dịch</h5>
                    <small class="text-body-secondary">Bản này đã bỏ title và time, dùng ghi chú + ngày giao dịch theo API hiện tại.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="transaction-modal-layout">
                    <div class="transaction-modal-side">
                        <div class="transaction-detail-hero">
                            <div class="transaction-detail-hero-top">
                                <span class="badge bg-label-primary" id="detailId">---</span>
                                <span class="badge bg-label-secondary" id="detailBadgeText">Một lần</span>
                            </div>
                            <div class="transaction-detail-hero-icon" id="detailHeroIconWrap">
                                <i class="bx bx-category" id="detailHeroIcon"></i>
                            </div>
                            <h4 class="mb-1" id="detailNoteText">Không có ghi chú</h4>
                            <div class="transaction-modal-amount" id="detailAmountText">0 VND</div>
                            <div class="transaction-modal-side-info">
                                <div class="transaction-side-info-item"><span>Loại</span><strong id="detailTypeText">Chi tiêu</strong></div>
                                <div class="transaction-side-info-item"><span>Danh mục</span><strong id="detailCategoryText">---</strong></div>
                                <div class="transaction-side-info-item"><span>Ví</span><strong id="detailWalletText">---</strong></div>
                                <div class="transaction-side-info-item"><span>Ngày giao dịch</span><strong id="detailDateText">--/--/----</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="transaction-modal-form">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Loại giao dịch</label>
                                <div class="transaction-toggle-group" id="detailTypeSwitch">
                                    <button type="button" class="active" data-value="expense">Chi tiêu</button>
                                    <button type="button" data-value="income">Thu nhập</button>
                                </div>
                                <input type="hidden" id="detailEditType" value="expense" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Số tiền</label>
                                <input type="number" class="form-control" id="detailEditAmount" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ví</label>
                                <select class="form-select" id="detailEditWallet">
                                    @foreach (var wallet in Model.Wallets)
                                    {
                                        <option value="@wallet.wallet_id">@wallet.wallet_name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ngày</label>
                                <input type="date" class="form-control" id="detailEditDate" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Lặp lại</label>
                                <select class="form-select" id="detailEditRecurrence">
                                    <option value="">Không lặp</option>
                                    <option value="daily">Hàng ngày</option>
                                    <option value="weekly">Hàng tuần</option>
                                    <option value="monthly">Hàng tháng</option>
                                    <option value="yearly">Hàng năm</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Danh mục</label>
                                <div class="transaction-category-grid" id="detailCategoryGrid">
                                    @foreach (var category in Model.Categories)
                                    {
                                        var categoryColor = string.IsNullOrWhiteSpace(category.color) ? "#8592A3" : category.color;
                                        var categoryIcon = string.IsNullOrWhiteSpace(category.icon) ? "bx bx-category" : category.icon;
                                        <button type="button" class="transaction-category-chip" data-id="@category.category_id" data-name="@category.category_name" data-icon="@categoryIcon" data-color="@categoryColor">
                                            <span class="transaction-category-icon" style="background:@($"{categoryColor}18"); color:@categoryColor;">
                                                <i class="@categoryIcon"></i>
                                            </span>
                                            <span>@category.category_name</span>
                                        </button>
                                    }
                                </div>
                                <input type="hidden" id="detailEditCategory" />
                                <input type="hidden" id="detailEditCategoryId" />
                                <input type="hidden" id="detailEditCategoryIcon" />
                                <input type="hidden" id="detailEditCategoryColor" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" rows="5" id="detailEditNote" placeholder="Ghi chú ngắn cho giao dịch..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteTransactionStatic"><i class="bx bx-trash me-1"></i> Xóa giao dịch</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnUpdateTransactionStatic">Lưu thay đổi</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade transaction-modal" id="addTransactionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title">Thêm giao dịch mới</h5>
                    <small class="text-body-secondary">Bản chuẩn hóa theo API: không title, không time.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="transaction-modal-layout">
                    <div class="transaction-modal-side">
                        <div class="transaction-add-preview">
                            <div class="transaction-preview-top">
                                <span class="badge bg-label-primary">Xem trước</span>
                                <span class="transaction-preview-type" id="addPreviewTypeText">Chi tiêu</span>
                            </div>
                            <div class="transaction-preview-icon" id="addPreviewIconWrap">
                                <i class="bx bx-category" id="addPreviewIcon"></i>
                            </div>
                            <h4 class="mb-1" id="addPreviewNote">Chưa có ghi chú cho giao dịch này.</h4>
                            <div class="transaction-modal-amount" id="addPreviewAmount">0 VND</div>
                            <div class="transaction-modal-side-info">
                                <div class="transaction-side-info-item"><span>Danh mục</span><strong id="addPreviewCategory">Chưa chọn</strong></div>
                                <div class="transaction-side-info-item"><span>Ví</span><strong id="addPreviewWallet">---</strong></div>
                                <div class="transaction-side-info-item"><span>Ngày</span><strong id="addPreviewDate">--/--/----</strong></div>
                                <div class="transaction-side-info-item"><span>Chu kỳ</span><strong id="addPreviewRepeat">Không lặp</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="transaction-modal-form">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Số tiền</label>
                                <input type="number" class="form-control" id="addTransactionAmount" placeholder="0" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Loại giao dịch</label>
                                <div class="transaction-toggle-group" id="addTypeSwitch">
                                    <button type="button" class="active" data-value="expense">Chi tiêu</button>
                                    <button type="button" data-value="income">Thu nhập</button>
                                </div>
                                <input type="hidden" id="addTransactionType" value="expense" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ví</label>
                                <select class="form-select" id="addTransactionWallet">
                                    @foreach (var wallet in Model.Wallets)
                                    {
                                        <option value="@wallet.wallet_id" data-name="@wallet.wallet_name">@wallet.wallet_name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Lặp lại</label>
                                <select class="form-select" id="addTransactionRecurrence">
                                    <option value="">Không lặp</option>
                                    <option value="daily">Hàng ngày</option>
                                    <option value="weekly">Hàng tuần</option>
                                    <option value="monthly">Hàng tháng</option>
                                    <option value="yearly">Hàng năm</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Danh mục</label>
                                <div class="transaction-category-grid" id="addCategoryGrid">
                                    @foreach (var category in Model.Categories)
                                    {
                                        var categoryColor = string.IsNullOrWhiteSpace(category.color) ? "#8592A3" : category.color;
                                        var categoryIcon = string.IsNullOrWhiteSpace(category.icon) ? "bx bx-category" : category.icon;
                                        <button type="button" class="transaction-category-chip" data-id="@category.category_id" data-name="@category.category_name" data-icon="@categoryIcon" data-color="@categoryColor">
                                            <span class="transaction-category-icon" style="background:@($"{categoryColor}18"); color:@categoryColor;">
                                                <i class="@categoryIcon"></i>
                                            </span>
                                            <span>@category.category_name</span>
                                        </button>
                                    }
                                </div>
                                <input type="hidden" id="addTransactionCategory" />
                                <input type="hidden" id="addTransactionCategoryId" />
                                <input type="hidden" id="addTransactionCategoryIcon" />
                                <input type="hidden" id="addTransactionCategoryColor" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ngày</label>
                                <input type="date" class="form-control" id="addTransactionDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" rows="5" id="addTransactionNote" placeholder="Ví dụ: ăn tối cùng nhóm, nhận lương, mua đồ dùng..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveTransactionStatic">Lưu giao dịch</button>
            </div>
        </div>
    </div>
</div>

<div class="position-fixed top-0 end-0 p-3 transaction-toast-stack">
    <div id="transactionToastSaved" class="toast align-items-center text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body">Đã sẵn sàng cho bước nối API tạo mới.</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
    <div id="transactionToastUpdated" class="toast align-items-center text-bg-primary border-0" role="alert"><div class="d-flex"><div class="toast-body">Đã sẵn sàng cho bước nối API cập nhật.</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>
