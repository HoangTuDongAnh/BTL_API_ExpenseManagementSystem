@model ExpenseWeb.Models.ViewModels.Admin.AdminSupportRequestDetailViewModel
@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    string StatusBadgeClass(string status) => status switch
    {
        "pending" => "bg-label-primary",
        "viewed" => "bg-label-warning",
        "replied" => "bg-label-success",
        "closed" => "bg-label-secondary",
        _ => "bg-label-secondary"
    };

    string PriorityBadgeClass(string priority) => priority switch
    {
        "low" => "bg-label-info",
        "medium" => "bg-label-warning",
        "high" => "bg-label-danger",
        "urgent" => "bg-danger text-white",
        _ => "bg-label-secondary"
    };
}

<div class="support-detail">

    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.UserAvatar))
        {
            <img src="@Model.UserAvatar" alt="avatar" class="rounded-circle" width="48" height="48" style="object-fit:cover;" />
        }
        else
        {
            <div class="avatar-initial rounded-circle bg-label-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px;font-size:1.2rem;font-weight:600;">
                @(Model.UserFullName?.Length > 0 ? Model.UserFullName[0].ToString().ToUpper() : "?")
            </div>
        }
        <div>
            <div class="fw-bold text-heading">@Model.UserFullName</div>
            <small class="text-muted">@Model.UserEmail</small>
        </div>
    </div>

    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-label-secondary font-monospace">@Model.SupportRequestId</span>
        <span class="badge @StatusBadgeClass(Model.Status)">@Model.StatusLabel</span>
        <span class="badge @PriorityBadgeClass(Model.Priority)">@Model.PriorityLabel</span>
        <span class="badge bg-label-info">@Model.SupportTypeLabel</span>
    </div>

    <div class="mb-3">
        <div class="text-muted small mb-1">@T("Tiêu đề", "Subject")</div>
        <div class="fw-bold text-dark">@Model.Subject</div>
    </div>

    <div class="mb-3">
        <div class="text-muted small mb-1">@T("Nội dung", "Message")</div>
        <div class="p-3 bg-light rounded" style="white-space: pre-wrap; word-break: break-word;">@Model.Message</div>
    </div>

    <div class="mb-3 d-flex flex-column gap-1">
        <small class="text-muted"><i class="bx bx-time me-1"></i>@T("Gửi lúc", "Sent at"): <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></small>
        @if (Model.ViewedAt.HasValue)
        {
            <small class="text-muted"><i class="bx bx-show me-1"></i>@T("Đã xem", "Viewed at"): <strong>@Model.ViewedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></small>
        }
        @if (Model.RepliedAt.HasValue)
        {
            <small class="text-muted"><i class="bx bx-reply me-1"></i>@T("Phản hồi lúc", "Replied at"): <strong>@Model.RepliedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></small>
        }
        @if (Model.ClosedAt.HasValue)
        {
            <small class="text-muted"><i class="bx bx-lock me-1"></i>@T("Đóng lúc", "Closed at"): <strong>@Model.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></small>
        }
    </div>

    @if (Model.Attachments.Count > 0)
    {
        <div class="mb-3">
            <div class="text-muted small mb-2">@T("Tệp đính kèm", "Attachments") (@Model.Attachments.Count)</div>
            <div class="support-attachment-grid">
                @foreach (var attachment in Model.Attachments)
                {
                    <div class="support-attachment-card">
                        @if (attachment.IsImage)
                        {
                            <img src="@attachment.FileUrl" alt="@attachment.FileName" class="support-attachment-preview view-media-btn" data-type="image" data-src="@attachment.FileUrl" style="cursor: pointer;" title="@T("Nhấn để xem lớn", "Click to view larger")" />
                        }
                        else if (attachment.IsVideo)
                        {
                            <div class="position-relative view-media-btn" data-type="video" data-src="@attachment.FileUrl" style="cursor: pointer;" title="@T("Nhấn để xem lớn", "Click to view larger")">
                                <video class="support-attachment-video" preload="metadata" style="pointer-events: none;">
                                    <source src="@attachment.FileUrl" type="@attachment.FileType" />
                                </video>
                                <div class="position-absolute top-50 start-50 translate-middle text-white" style="background: rgba(0,0,0,0.4); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bx bx-play ms-1 fs-3"></i>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="support-attachment-preview d-flex align-items-center justify-content-center">
                                <i class="bx bx-file fs-1 text-muted"></i>
                            </div>
                        }

                        <div class="support-attachment-body">
                            <div class="support-attachment-name" title="@attachment.FileName">@attachment.FileName</div>
                            <div class="support-attachment-meta">
                                @if (!string.IsNullOrWhiteSpace(attachment.DisplaySize))
                                {
                                    <span>@attachment.DisplaySize</span>
                                }
                            </div>

                            @if (attachment.IsImage || attachment.IsVideo)
                            {
                                <a href="javascript:void(0);" class="small text-primary text-decoration-none view-media-btn" data-type="@(attachment.IsImage ? "image" : "video")" data-src="@attachment.FileUrl">
                                    @T("Mở xem", "View")
                                </a>
                            }
                            else
                            {
                                <a href="@attachment.FileUrl" target="_blank" class="small text-primary text-decoration-none">
                                    @T("Tải xuống", "Download")
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.AdminReply))
    {
        <div class="mb-4">
            <div class="text-muted small mb-1">@T("Phản hồi của quản trị viên", "Admin Reply")</div>
            <div class="p-3 border-start border-3 border-success bg-light rounded" style="white-space: pre-wrap; word-break: break-word;">
                @Model.AdminReply
            </div>
        </div>
    }

    @if (Model.Status != "closed")
    {
        <hr class="my-3" />
        <div>
            <div class="fw-semibold mb-2"><i class="bx bx-reply me-1 text-primary"></i>@T("Gửi phản hồi", "Send Reply")</div>
            <form method="post" asp-action="ReplySupport" asp-controller="Admin">
                <input type="hidden" name="supportRequestId" value="@Model.SupportRequestId" />

                <textarea name="adminReply" class="form-control mb-2" rows="4"
                      placeholder="@T("Nhập nội dung phản hồi...", "Enter reply content...")"
                      style="resize:vertical;">@Model.AdminReply</textarea>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" name="status" value="replied" class="btn btn-primary btn-sm">
                        <i class="bx bx-send me-1"></i>@T("Gửi phản hồi", "Send Reply")
                    </button>
                    @if (Model.Status == "pending")
                    {
                        <button type="submit" name="status" value="viewed" class="btn btn-outline-warning btn-sm">
                            <i class="bx bx-show me-1"></i>@T("Đánh dấu đã xem", "Mark as Viewed")
                        </button>
                    }
                    <button type="submit" name="status" value="closed" class="btn btn-outline-secondary btn-sm">
                        <i class="bx bx-lock me-1"></i>@T("Đóng yêu cầu", "Close Request")
                    </button>
                </div>
            </form>
        </div>
    }
</div>