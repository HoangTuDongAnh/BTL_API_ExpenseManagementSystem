@model ExpenseWeb.Models.ViewModels.Admin.AdminErrorReportsPageViewModel
@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;
    ViewData["Title"] = T("Quản lý yêu cầu hỗ trợ", "User Support Requests");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/page.admin-reports.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Quản trị hệ thống", "System Administration")</span>
            <h1 class="dashboard-hero-title">@T("Tiếp nhận yêu cầu hỗ trợ và báo lỗi từ người dùng", "Review support requests and issue reports from users")</h1>
            <p class="dashboard-hero-text">
                @T("Sắp xếp, theo dõi và phản hồi từng phản ánh để quá trình hỗ trợ rõ ràng hơn và không bỏ lỡ các vấn đề cần xử lý sớm.", "Organize, track, and respond to each report so the support flow stays clear and urgent issues are not missed.")
            </p>
        </div>
    </section>

    @if (TempData["AdminSupportSuccess"] is string success && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <i class="bx bx-check-circle me-1"></i> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title m-0"><i class="bx bx-filter-alt me-2 text-primary"></i>@T("Bộ lọc tìm kiếm", "Search Filters")</h5>
        </div>
        <div class="card-body pt-4">
            <form method="get" asp-action="ErrorReports" asp-controller="Admin" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@T("Trạng thái", "Status")</label>
                    <select name="status" class="form-select">
                        <option value="">@T("Tất cả", "All")</option>
                        <option value="pending" selected="@(Model.CurrentStatus == "pending")">@T("Chờ tiếp nhận", "Pending")</option>
                        <option value="viewed" selected="@(Model.CurrentStatus == "viewed")">@T("Đang xử lý", "Processing")</option>
                        <option value="replied" selected="@(Model.CurrentStatus == "replied")">@T("Đã phản hồi", "Replied")</option>
                        <option value="closed" selected="@(Model.CurrentStatus == "closed")">@T("Đã đóng", "Closed")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@T("Loại hỗ trợ", "Support Type")</label>
                    <select name="supportType" class="form-select">
                        <option value="">@T("Tất cả", "All")</option>
                        <option value="bug" selected="@(Model.CurrentSupportType == "bug")">@T("Báo lỗi hệ thống", "System Bug")</option>
                        <option value="transaction" selected="@(Model.CurrentSupportType == "transaction")">@T("Hỗ trợ giao dịch", "Transaction Support")</option>
                        <option value="account" selected="@(Model.CurrentSupportType == "account")">@T("Hỗ trợ tài khoản", "Account Support")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@T("Ưu tiên", "Priority")</label>
                    <select name="priority" class="form-select">
                        <option value="">@T("Tất cả", "All")</option>
                        <option value="low" selected="@(Model.CurrentPriority == "low")">@T("Thấp", "Low")</option>
                        <option value="high" selected="@(Model.CurrentPriority == "high")">@T("Cao", "High")</option>
                        <option value="urgent" selected="@(Model.CurrentPriority == "urgent")">@T("Khẩn cấp", "Urgent")</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@T("Từ khóa", "Keyword")</label>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="@T("Tìm theo tiêu đề hoặc email user...", "Search by title or user email...")" />
                </div>
                <div class="col-12 mt-3 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-search-alt me-1"></i> @T("Tìm kiếm", "Search")
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header border-bottom pb-3">
            <h5 class="card-title m-0"><i class="bx bx-list-ul me-2 text-primary"></i>@T("Danh sách yêu cầu", "Request List")</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-custom-scroll text-nowrap">
                <table class="table table-hover mb-0">
                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                        <tr>
                            <th>@T("Mã & Tiêu đề", "Ticket & Title")</th>
                            <th>@T("Người dùng", "User")</th>
                            <th>@T("Danh mục & Ưu tiên", "Category & Priority")</th>
                            <th>@T("Ngày gửi", "Reported At")</th>
                            <th>@T("Trạng thái", "Status")</th>
                            <th>@T("Thao tác", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bx bx-folder-open fs-1 mb-2"></i>
                                    <p>@T("Chưa có dữ liệu hỗ trợ phù hợp.", "No matching support requests found.")</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr class="support-item-row" style="cursor: pointer;" data-id="@item.SupportRequestId">
                                    <td class="text-wrap">
                                        <span class="text-primary fw-medium small">@item.SupportRequestId</span><br />
                                        <span class="fw-bold text-dark">@item.Subject</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-heading">@item.UserFullName</div>
                                        <small class="text-muted">@item.UserEmail</small>
                                    </td>
                                    <td>
                                        <span class="badge @item.SupportTypeBadgeClass mb-1">@item.SupportTypeLabel</span><br />
                                        <span class="badge @item.PriorityBadgeClass">@T("Ưu tiên:", "Priority:") @item.PriorityLabel</span>
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass">@item.StatusLabel</span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary">
                                            <i class="bx bx-show me-1"></i> @T("Xem", "View")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="requestDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title"><i class="bx bx-detail me-2 text-primary"></i>@T("Chi tiết yêu cầu", "Request Details")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalDetailContent">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mediaViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0" id="mediaViewerContent">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.support-item-row').on('click', function () {
                const requestId = $(this).data('id');
                const $container = $('#modalDetailContent');

                $container.html(`
                    <div class="d-flex flex-column align-items-center justify-content-center py-5">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <span class="text-muted">@T("Đang tải chi tiết...", "Loading details...")</span>
                    </div>
                `);

                $('#requestDetailModal').modal('show');

                $.ajax({
                    url: '@Url.Action("GetSupportDetail", "Admin")',
                    type: 'GET',
                    data: { id: requestId },
                    success: function (html) {
                        $container.hide().html(html).fadeIn(200);
                        const currentUrl = new URL(window.location);
                        currentUrl.searchParams.set('selectedId', requestId);
                        window.history.pushState({}, '', currentUrl);
                    },
                    error: function () {
                        $container.html('<div class="alert alert-danger mt-3">@T("Không thể tải dữ liệu. Vui lòng thử lại.", "Failed to load data. Please try again.")</div>');
                    }
                });
            });

            $(document).on('click', '.view-media-btn', function(e) {
                e.preventDefault();
                var type = $(this).data('type');
                var src = $(this).data('src');
                var $content = $('#mediaViewerContent');

                $content.empty();

                if (type === 'image') {
                    $content.html('<img src="' + src + '" class="rounded shadow" style="width: 100%; height: 80vh; object-fit: contain; background-color: rgba(0,0,0,0.2);" />');
                } else if (type === 'video') {
                    $content.html(`
                        <video controls autoplay class="rounded shadow" style="width: 100%; height: 80vh; object-fit: contain; background-color: rgba(0,0,0,0.2);">
                            <source src="${src}" type="video/mp4">
                            @T("Trình duyệt của bạn không hỗ trợ thẻ video.", "Your browser does not support the video tag.")
                        </video>
                    `);
                }

                $('#mediaViewerModal').modal('show');
            });

            $('#mediaViewerModal').on('hidden.bs.modal', function () {
                $('#mediaViewerContent').empty();
            });
        });
    </script>
}