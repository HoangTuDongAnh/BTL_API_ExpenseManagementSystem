

@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    ViewData["Title"] = T("Bảng điều khiển Admin", "Admin Dashboard");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/page.admin-dashboard.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Quản trị hệ thống", "System Administration")</span>
            <h1 class="dashboard-hero-title">@T("Theo dõi hoạt động quản trị trong một màn hình tập trung", "Keep administration activity in one focused workspace")</h1>
            <p class="dashboard-hero-text">
                @T("Nắm nhanh tình hình người dùng, mức độ sử dụng và các tín hiệu cần chú ý để việc vận hành hệ thống luôn liền mạch.", "Quickly review users, usage patterns, and signals that need attention to keep system operations running smoothly.")
            </p>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-12 col-6">
            <div class="card h-100 report-card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between mb-4">
                        <div class="avatar flex-shrink-0">
                            <span class="avatar-initial rounded-2 bg-label-primary">
                                <i class="bx bx-user icon-lg"></i>
                            </span>
                        </div>
                    </div>
                    <p class="mb-1 fw-semibold text-muted">@T("Tổng số người dùng", "Total Users")</p>
                    <h4 class="card-title mb-3">1,248</h4>
                    <small class="text-success fw-medium"><i class="bx bx-up-arrow-alt"></i> +12.5%</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12 col-6">
            <div class="card h-100 report-card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between mb-4">
                        <div class="avatar flex-shrink-0">
                            <span class="avatar-initial rounded-2 bg-label-success">
                                <i class="bx bx-check-shield icon-lg"></i>
                            </span>
                        </div>
                    </div>
                    <p class="mb-1 fw-semibold text-muted">@T("Hoạt động hôm nay", "Active Today")</p>
                    <h4 class="card-title mb-3">156</h4>
                    <small class="text-success fw-medium"><i class="bx bx-up-arrow-alt"></i> +5.2%</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12 col-6">
            <div class="card h-100 report-card">
                <div class="card-body">
                    <div class="card-title d-flex align-items-start justify-content-between mb-4">
                        <div class="avatar flex-shrink-0">
                            <span class="avatar-initial rounded-2 bg-label-danger">
                                <i class="bx bx-message-square-error icon-lg"></i>
                            </span>
                        </div>
                    </div>
                    <p class="mb-1 fw-semibold text-muted">@T("Báo cáo mới", "New Reports")</p>
                    <h4 class="card-title mb-3">12</h4>
                    <small class="text-danger fw-medium"><i class="bx bx-up-arrow-alt"></i> +2 @T("Mới", "New")</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-8">
            <div class="card h-100 report-card">
                <div class="card-header border-bottom pb-3">
                    <h3 class="report-title m-0"><i class="bx bx-line-chart me-2 text-primary"></i>@T("Xu hướng người dùng mới (Tuần)", "New Users Trend (Weekly)")</h3>
                </div>
                <div class="card-body pt-4">
                    <div id="userTrendChart"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card h-100 report-card">
                <div class="card-header border-bottom pb-3">
                    <h3 class="report-title m-0"><i class="bx bx-pie-chart-alt-2 me-2 text-primary"></i>@T("Tỷ lệ trạng thái", "Status Ratio")</h3>
                </div>
                <div class="card-body pt-4 d-flex align-items-center justify-content-center">
                    <div id="userStatusChart" class="w-100"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card report-card">
        <div class="card-header border-bottom pb-3 d-flex justify-content-between align-items-center">
            <h3 class="report-title m-0"><i class="bx bx-group me-2 text-primary"></i>@T("Quản lý người dùng", "User Management")</h3>
            <button class="btn btn-sm btn-primary"><i class="bx bx-plus me-1"></i>@T("Thêm mới", "Add New")</button>
        </div>
        <div class="table-responsive text-nowrap">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@T("Người dùng", "User")</th>
                        <th>@T("Email", "Email")</th>
                        <th>@T("Vai trò", "Role")</th>
                        <th>@T("Trạng thái", "Status")</th>
                        <th>@T("Thao tác", "Actions")</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <ul class="list-unstyled m-0 avatar-group d-flex align-items-center me-3">
                                    <li class="avatar avatar-xs">
                                        <img src="~/sneat/img/avatars/1.png" alt="Avatar" class="rounded-circle" />
                                    </li>
                                </ul>
                                <span class="fw-medium text-dark">Nguyễn Văn A</span>
                            </div>
                        </td>
                        <td class="text-muted">vana@example.com</td>
                        <td><span class="badge bg-label-info">@T("Người dùng", "User")</span></td>
                        <td><span class="badge bg-label-success me-1">@T("Hoạt động", "Active")</span></td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="offcanvas"
                                    data-bs-target="#offcanvasUserDetails"
                                    aria-controls="offcanvasUserDetails">
                                <i class="bx bx-show me-1"></i> @T("Chi tiết", "Details")
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_UserOffcanvas" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Cấu hình Line Chart (Biểu đồ đường)
            const lineChartEl = document.querySelector('#userTrendChart');
            const lineChartOptions = {
                series: [{
                    name: '@Html.Raw(T("Người dùng mới", "New Users"))',
                    data: [10, 41, 35, 51, 49, 62, 69]
                }],
                chart: {
                    height: 320,
                    type: 'line',
                    toolbar: { show: false },
                    parentHeightOffset: 0
                },
                colors: ['#696cff'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 3 },
                grid: { borderColor: '#e9eceef' },
                xaxis: {
                    categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: {
                    labels: { style: { colors: '#a1acb8' } }
                }
            };
            const lineChart = new ApexCharts(lineChartEl, lineChartOptions);
            lineChart.render();

            // 2. Cấu hình Pie Chart (Biểu đồ tròn)
            const pieChartEl = document.querySelector('#userStatusChart');
            const pieChartOptions = {
                series: [85, 15],
                labels: ['@Html.Raw(T("Hoạt động", "Active"))', '@Html.Raw(T("Không hoạt động", "Inactive"))'],
                chart: {
                    type: 'donut',
                    height: 320,
                    parentHeightOffset: 0
                },
                colors: ['#71dd37', '#8592a3'],
                legend: { position: 'bottom' },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '75%',
                            labels: {
                                show: true,
                                value: {
                                    fontSize: '22px',
                                    color: '#566a7f',
                                    fontWeight: 600
                                },
                                total: {
                                    show: true,
                                    label: '@Html.Raw(T("Trạng thái", "Status"))',
                                    fontSize: '15px',
                                    color: '#a1acb8',
                                    formatter: function (w) { return '100%' }
                                }
                            }
                        }
                    }
                }
            };
            const pieChart = new ApexCharts(pieChartEl, pieChartOptions);
            pieChart.render();
        });
    </script>
}