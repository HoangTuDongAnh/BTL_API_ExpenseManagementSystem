@model ExpenseWeb.Models.ViewModels.Category.CategoryPageViewModel
@using System.IO
@using System.Linq
@using ExpenseWeb.Models.Dtos.Category
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewBag.Title = "Danh mục & Hạn mức";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = Model?.Lang ?? (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    var categoryIconFolderPhysical = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "sneat", "img", "icons", "categories");
    var categoryIconFiles = System.IO.Directory.Exists(categoryIconFolderPhysical)
        ? System.IO.Directory.GetFiles(categoryIconFolderPhysical)
            .Where(f => new[] { ".png", ".svg", ".webp", ".jpg", ".jpeg" }.Contains(System.IO.Path.GetExtension(f).ToLower()))
            .Select(System.IO.Path.GetFileName)
            .OrderBy(x => x)
            .ToList()
        : new List<string>();

    var presetColors = new[]
    {
        "#FFAB00", "#696CFF", "#03C3EC", "#71DD37",
        "#FF3E1D", "#8592A3", "#8C57FF", "#233446"
    };

    string iconAt(int index) => categoryIconFiles.Count > 0
        ? $"/sneat/img/icons/categories/{categoryIconFiles[index % categoryIconFiles.Count]}"
        : "";

    string resolveIcon(CategoryOverviewResponseDto item, int index)
    {
        if (!string.IsNullOrWhiteSpace(item.icon) && item.icon.StartsWith("/"))
        {
            return item.icon;
        }

        return iconAt(index);
    }

    string budgetTypeLabel(string? periodType) => periodType?.ToLower() switch
    {
        "week" => T("Tuần", "Week"),
        "month" => T("Tháng", "Month"),
        "year" => T("Năm", "Year"),
        _ => T("Tháng", "Month")
    };

    string currency(decimal value) => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}", value);

    var categories = Model?.Categories ?? new List<CategoryOverviewResponseDto>();
    var overBudgetItem = categories.FirstOrDefault(x => x.budget?.status == "over");
    var goodItem = categories
        .Where(x => x.budget != null && x.budget.status == "normal" && (x.budget.percentage_used ?? 0) > 0)
        .OrderBy(x => x.budget!.percentage_used)
        .FirstOrDefault();
    var trendingItems = categories
        .Where(x => x.budget != null && (x.budget.spent_amount ?? 0) > 0)
        .OrderByDescending(x => x.budget!.spent_amount)
        .Take(2)
        .ToList();
    var trendingNames = string.Join(lang == "en" ? " and " : " và ", trendingItems.Select(x => x.category_name));
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/category-page.css" />
    <style>
        .category-card.has-budget {
            background-color: #fff;
            border: 1px solid #e1e4e8 !important;
            position: relative;
            box-shadow: 0 2px 6px 0 rgba(67, 89, 113, 0.05);
            transition: all 0.3s ease-in-out;
        }

            .category-card.has-budget:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 12px 0 rgba(67, 89, 113, 0.15);
                border-color: #696cff !important;
            }

        .category-card.over-budget {
            background-color: #fffaf9 !important;
            border-color: #ff3e1d !important;
        }

            .category-card.over-budget:hover {
                box-shadow: 0 4px 12px 0 rgba(255, 62, 29, 0.2);
            }

        .budget-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 1.25rem;
            color: #696cff;
        }

        .bg-lighter {
            background-color: #f8f9fa;
        }

        .progress {
            border-radius: 10px;
            background-color: #e9ecef;
        }

        .progress-bar {
            border-radius: 10px;
        }
    </style>
}

<input type="hidden" id="categoryPagePeriodType" value="@Model.CurrentPeriodType" />
<input type="hidden" id="categoryPageYear" value="@Model.CurrentYear" />
<input type="hidden" id="categoryPageMonth" value="@Model.CurrentMonth" />
<input type="hidden" id="categoryPageWeek" value="@Model.CurrentWeek" />
<input type="hidden" id="categoryCreateUrl" value="@Url.Action("Create", "Category")" />
<input type="hidden" id="categoryUpdateBaseUrl" value="@Url.Action("Update", "Category", new { id = "__id__" })" />
<input type="hidden" id="categoryDeleteBaseUrl" value="@Url.Action("Delete", "Category", new { id = "__id__" })" />
<input type="hidden" id="categorySaveBudgetUrl" value="@Url.Action("SaveBudget", "Category")" />

<div class="container-xxl flex-grow-1 container-p-y">
    @if (TempData["CategoryPageError"] != null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @TempData["CategoryPageError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="mb-1">@T("Danh sách danh mục & Hạn mức", "Category & Budget List")</h5>
                <p class="card-subtitle mb-0">
                    @T("Quản lý danh mục chi tiêu và thiết lập hạn mức.", "Manage categories and set budgets.")
                </p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                <i class="icon-base bx bx-plus me-1"></i> @T("Thêm danh mục", "Add Category")
            </button>
        </div>

        <div class="card-body">
            <div class="row g-4 category-grid">
                @if (categories.Any())
                {
                    @for (var i = 0; i < categories.Count; i++)
                    {
                        var item = categories[i];
                        var budget = item.budget;
                        var hasBudget = budget != null && !string.IsNullOrWhiteSpace(budget.budget_id);
                        var iconUrl = resolveIcon(item, i);
                        var color = string.IsNullOrWhiteSpace(item.color) ? presetColors[i % presetColors.Length] : item.color!;
                        var spent = budget?.spent_amount ?? 0;
                        var total = budget?.limit_amount ?? 0;
                        var percentage = budget?.percentage_used ?? 0;
                        var remaining = budget?.remaining_amount ?? 0;
                        var status = budget?.status ?? "none";
                        var progressWidth = Math.Min(Math.Max(percentage, 0), 100);
                        var badgeIcon = status == "over" ? "bx-error-circle text-danger" : status == "reached" ? "bx-error text-warning" : "bx-wallet";
                        var cardCss = hasBudget ? "has-budget" : string.Empty;
                        if (status == "over") { cardCss += " over-budget"; }
                        var budgetType = budgetTypeLabel(budget?.period_type);
                        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                            <button type="button" class="card category-card @cardCss text-start w-100 h-100"
                                    data-bs-toggle="modal" data-bs-target="#categoryDetailModal"
                                    data-category-id="@item.category_id"
                                    data-category-name="@item.category_name"
                                    data-category-color="@color"
                                    data-category-icon="@iconUrl"
                                    data-category-is-default="@(item.is_default.ToString().ToLower())"
                                    data-category-can-edit="@(item.can_edit.ToString().ToLower())"
                                    data-category-can-delete="@(item.can_delete.ToString().ToLower())"
                                    data-has-budget="@(hasBudget.ToString().ToLower())"
                                    data-budget-id="@(budget?.budget_id ?? string.Empty)"
                                    data-budget-amount="@total"
                                    data-budget-spent="@spent"
                                    data-budget-status="@status"
                                    data-budget-type="@budgetType"
                                    data-budget-period-type="@(budget?.period_type ?? string.Empty)">
                                @if (hasBudget)
                                {
                                    <i class="bx @badgeIcon budget-badge" title="Budget"></i>
                                }
                                <div class="card-body w-100">
                                    <div class="category-icon-wrap mb-2" style="background: @(color + "22");">
                                        @if (!string.IsNullOrWhiteSpace(iconUrl))
                                        {
                                            <img src="@iconUrl" class="category-icon-img" alt="@item.category_name" />
                                        }
                                    </div>
                                    <div class="category-name fw-bold">@item.category_name</div>
                                    <div class="mt-3">
                                        @if (hasBudget)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.7rem;">
                                                @if (status == "over")
                                                {
                                                    <span class="text-danger fw-bold">@T("Vượt", "Over") @currency(Math.Abs(remaining))</span>
                                                }
                                                else if (status == "reached")
                                                {
                                                    <span class="text-warning fw-bold">@T("Đã hết", "Reached")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@currency(spent) / @currency(total)</span>
                                                }
                                            </div>
                                            <div class="progress" style="height: 5px;">
                                                <div class="progress-bar @(status == "over" ? "bg-danger" : status == "reached" ? "bg-warning" : "bg-primary")" style="width: @progressWidth%"></div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-label-secondary" style="font-size: 0.7rem;">@T("Chưa có hạn mức", "No budget")</span>
                                        }
                                    </div>
                                </div>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info mb-0">@T("Chưa có dữ liệu danh mục để hiển thị.", "No categories found.")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <h6 class="text-muted text-uppercase fw-bold mb-3 mt-4">@T("💡 Gợi ý thông minh", "💡 Smart Insights")</h6>
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card bg-label-danger h-100 shadow-none border-0">
                <div class="card-body d-flex align-items-start">
                    <i class="bx bx-error-circle fs-3 me-3 mt-1 text-danger"></i>
                    <div>
                        <h6 class="mb-1 text-danger fw-bold">@T("Cảnh báo vượt mức!", "Over budget warning!")</h6>
                        <p class="mb-0 small text-danger">
                            @if (overBudgetItem != null)
                            {
                                @T("Danh mục", "Category")
                                <strong>@overBudgetItem.category_name</strong>

                                @T("đang vượt hạn mức.", "is over budget.")
                            }
                            else
                            {
                                @T("Hiện chưa có danh mục nào vượt hạn mức.", "There is no over-budget category right now.")
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-label-success h-100 shadow-none border-0">
                <div class="card-body d-flex align-items-start">
                    <i class="bx bx-check-shield fs-3 me-3 mt-1 text-success"></i>
                    <div>
                        <h6 class="mb-1 text-success fw-bold">@T("Quản lý tốt", "Doing well")</h6>
                        <p class="mb-0 small text-success">
                            @if (goodItem != null)
                            {
                            @T("Bạn đang kiểm soát khá tốt hạng mục", "You are managing")
                            <strong>@goodItem.category_name</strong>
                            }
                            else
                            {
                                @T("Hãy thiết lập thêm hạn mức để hệ thống gợi ý chính xác hơn.", "Set more budgets to receive better suggestions.")
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-label-info h-100 shadow-none border-0">
                <div class="card-body d-flex align-items-start">
                    <i class="bx bx-pie-chart-alt-2 fs-3 me-3 mt-1 text-info"></i>
                    <div>
                        <h6 class="mb-1 text-info fw-bold">@T("Xu hướng chi tiêu", "Spending trend")</h6>
                        <p class="mb-0 small text-info">
                            @if (trendingItems.Any())
                            {
                                <strong>@trendingNames</strong>
                                @T("đang chiếm tỷ trọng chi tiêu lớn hơn.", "take up a larger share of spending.")
                            }
                            else
                            {
                                @T("Chưa có đủ dữ liệu chi tiêu để phân tích xu hướng.", "Not enough spending data to analyze trends yet.")
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade category-modal" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg category-modal-smaller">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h4 class="modal-title mb-1">@T("Thêm danh mục", "Add Category")</h4>
                    <p class="text-body-secondary mb-0 small">@T("Tạo nhanh một danh mục mới.", "Create a new category quickly.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên danh mục", "Category name")</label>
                        <input type="text" id="addCategoryName" class="form-control" placeholder="Ví dụ: Lương, Mua sắm..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Màu sắc", "Color")</label>
                        <div class="category-color-tools d-flex align-items-center gap-2">
                            <div class="category-color-presets d-flex gap-1 flex-wrap">
                                @foreach (var color in presetColors)
                                {
                                    <button type="button" class="category-color-preset @(color == "#FFAB00" ? "active" : "")" data-color="@color" style="background:@color; width: 24px; height: 24px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                }
                            </div>
                            <div class="category-color-custom d-flex align-items-center gap-2 ms-2">
                                <input type="color" id="addCategoryColor" class="form-control form-control-color p-0 border-0" value="#FFAB00" style="width: 30px; height: 30px;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@T("Biểu tượng", "Icon")</label>
                        <div class="category-icon-picker d-flex flex-wrap gap-2">
                            @if (categoryIconFiles.Any())
                            {
                                for (int i = 0; i < categoryIconFiles.Count; i++)
                                {
                                    var fileName = categoryIconFiles[i];
                                    <button type="button" class="category-icon-option category-icon-option-add btn btn-outline-secondary p-2 @(i == 0 ? "active" : "")" data-icon="/sneat/img/icons/categories/@fileName">
                                        <img src="~/sneat/img/icons/categories/@fileName" alt="@fileName" style="width: 24px; height: 24px;" />
                                    </button>
                                }
                            }
                        </div>
                        <input type="hidden" id="addCategoryIcon" value="@(categoryIconFiles.Any() ? $"/sneat/img/icons/categories/{categoryIconFiles.First()}" : "")" />
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top pt-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Hủy", "Cancel")</button>
                <button type="button" class="btn btn-primary" id="btnSaveCategoryStatic">@T("Tạo danh mục", "Create Category")</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade category-modal" id="categoryDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg category-modal-smaller">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h4 class="modal-title mb-1">@T("Chi tiết danh mục", "Category Details")</h4>
                    <p class="text-body-secondary mb-0 small">@T("Xem và chỉnh sửa nhanh danh mục.", "Quickly view and edit category info.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-4">
                <div class="category-detail-top card mb-4 shadow-none border">
                    <div class="card-body p-3">
                        <div class="category-preview-inline d-flex align-items-center gap-3">
                            <div id="detailHeadIconWrap" class="category-icon-wrap m-0" style="background: rgba(255,171,0,.14); width: 48px; height: 48px;">
                                <img id="detailHeadIcon" src="" class="category-icon-img w-50" alt="icon" />
                            </div>
                            <div>
                                <div class="category-name fw-bold fs-5" id="detailCategoryTitle">Danh mục</div>
                                <div class="category-meta">
                                    <span class="badge bg-label-primary me-1" id="detailCategoryId">CAT000</span>
                                    <span class="badge bg-label-secondary" id="detailCategoryTypeBadge"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" id="detailCategoryCanEdit" value="true" />
                <input type="hidden" id="detailCategoryCanDelete" value="true" />
                <input type="hidden" id="detailBudgetId" value="" />
                <input type="hidden" id="detailBudgetPeriodType" value="month" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@T("Tên danh mục", "Category name")</label>
                        <input type="text" id="detailCategoryName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@T("Màu sắc", "Color")</label>
                        <div class="category-color-tools d-flex align-items-center gap-2">
                            <div class="category-color-presets d-flex gap-1 flex-wrap">
                                @foreach (var color in presetColors)
                                {
                                    <button type="button" class="category-color-preset-detail @(color == "#FFAB00" ? "active" : "")" data-color="@color" style="background:@color; width: 24px; height: 24px; border-radius: 50%; border: none; cursor: pointer;"></button>
                                }
                            </div>
                            <div class="category-color-custom d-flex align-items-center gap-2 ms-2">
                                <input type="color" id="detailCategoryColor" class="form-control form-control-color p-0 border-0" value="#FFAB00" style="width: 30px; height: 30px;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@T("Biểu tượng", "Icon")</label>
                        <div class="category-icon-picker d-flex flex-wrap gap-2">
                            @if (categoryIconFiles.Any())
                            {
                                for (int i = 0; i < categoryIconFiles.Count; i++)
                                {
                                    var fileName = categoryIconFiles[i];
                                    <button type="button" class="category-icon-option category-icon-option-detail btn btn-outline-secondary p-2 @(i == 0 ? "active" : "")" data-icon="/sneat/img/icons/categories/@fileName">
                                        <img src="~/sneat/img/icons/categories/@fileName" alt="@fileName" style="width: 24px; height: 24px;" />
                                    </button>
                                }
                            }
                        </div>
                        <input type="hidden" id="detailCategoryIcon" value="" />
                    </div>

                    <div class="col-12">
                        <label class="form-label d-flex align-items-center mb-2">
                            <i class="bx bx-wallet text-warning me-1"></i>
                            @T("Hạn mức chi tiêu", "Budget Limit")
                        </label>

                        <div id="budgetInfoContainer">
                            <div id="noBudgetState" class="text-center py-4 border rounded bg-lighter d-none">
                                <p class="text-muted small mb-3">@T("Danh mục này chưa được thiết lập hạn mức.", "No budget set for this category.")</p>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#setBudgetModal">
                                    <i class="bx bx-plus me-1"></i> @T("Thêm hạn mức", "Add Budget")
                                </button>
                            </div>

                            <div id="hasBudgetState" class="d-none">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold fs-6" id="detailBudgetTitle">Ăn uống</span>
                                            <span class="badge bg-label-secondary" id="detailBudgetType">Tháng</span>
                                        </div>
                                        <span class="text-muted small fw-medium">
                                            <span id="detailSpentAmount">0 đ</span> / <span id="detailTotalAmount">0 đ</span>
                                        </span>
                                    </div>
                                    <div class="progress mb-2" style="height: 8px;">
                                        <div id="detailProgressBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span id="detailProgressText" class="fw-bold small">0%</span>
                                        <span id="detailStatusText" class="small fw-bold">---</span>
                                    </div>
                                    <div class="text-end border-top pt-2 mt-3">
                                        <button type="button" class="btn btn-sm btn-label-secondary" data-bs-toggle="modal" data-bs-target="#setBudgetModal">
                                            <i class="bx bx-edit me-1"></i> @T("Sửa hạn mức", "Edit Budget")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between border-top pt-3">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteCategoryStatic">
                    <i class="icon-base bx bx-trash me-1"></i> @T("Xóa danh mục", "Delete Category")
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                    <button type="button" class="btn btn-primary" id="btnUpdateCategoryStatic">
                        <i class="icon-base bx bx-save me-1"></i> @T("Lưu thay đổi", "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="setBudgetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title">@T("Thiết Lập Hạn Mức Chi Tiêu", "Set Budget Limit")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-4">
                <div class="mb-3">
                    <label class="form-label">@T("Danh Mục", "Category")</label>
                    <input type="text" id="budgetModalCategoryName" class="form-control bg-lighter" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("Loại Thời Gian", "Time Type")</label>
                    <select id="budgetModalTimeType" class="form-select">
                        <option value="week">@T("Theo tuần", "Weekly")</option>
                        <option value="month" selected>@T("Theo tháng", "Monthly")</option>
                        <option value="year">@T("Theo năm", "Yearly")</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("Ngân Sách Dự Kiến (VNĐ)", "Expected Budget (VND)")</label>
                    <input type="number" id="budgetModalAmount" class="form-control" placeholder="Ví dụ: 5000000" />
                </div>
                <div class="mb-4">
                    <label class="form-label">@T("Số Tiền Đã Chi (VNĐ)", "Spent Amount (VND)")</label>
                    <input type="number" id="budgetModalSpent" class="form-control bg-lighter" value="0" readonly />
                </div>
                <button type="button" class="btn btn-primary w-100" id="btnSaveBudget">
                    @T("Lưu Hạn Mức", "Save Budget")
                </button>
            </div>
        </div>
    </div>
</div>

