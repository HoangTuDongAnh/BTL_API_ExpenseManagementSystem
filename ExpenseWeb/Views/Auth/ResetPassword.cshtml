@model ExpenseWeb.Models.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">

            <div class="card px-sm-6 px-0">
                <div class="card-body">

                    <h4 class="mb-2 text-center">Reset Password 🔑</h4>
                    <p class="text-center mb-4">Enter your new password</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button class="btn btn-primary d-grid w-100" type="submit">
                            Reset Password
                        </button>
                    </form>

                    <p class="text-center mt-4">
                        <a href="@Url.Action("Login", "Auth")">Back to login</a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}