@model ExpenseWeb.Models.ViewModels.Auth.VerifyOtpViewModel
@{
    ViewBag.Title = "Verify OTP";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
}

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">
            <div class="card px-sm-6 px-0">
                <div class="card-body">
                    <h4 class="mb-2 text-center">Verify OTP</h4>
                    <p class="text-center mb-4">Enter the OTP sent to <strong>@Model.Email</strong>.</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <form asp-action="VerifyOtp" asp-controller="Auth" method="post" class="mb-4">
                        <input type="hidden" asp-for="Email" />
                        <div class="mb-3">
                            <label asp-for="Otp" class="form-label">OTP code</label>
                            <input asp-for="Otp" class="form-control" maxlength="6" placeholder="Enter OTP" autofocus />
                            <span asp-validation-for="Otp" class="text-danger"></span>
                        </div>
                        <button class="btn btn-primary d-grid w-100" type="submit">Verify</button>
                    </form>

                    <form asp-action="ResendOtp" asp-controller="Auth" method="post" class="mb-3">
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button class="btn btn-outline-secondary d-grid w-100" type="submit">Resend OTP</button>
                    </form>

                    <p class="text-center mb-0">
                        <a href="@Url.Action("Login", "Auth")">Back to login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
