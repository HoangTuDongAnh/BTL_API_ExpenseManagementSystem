@model VerifyOtpViewModel

@{
    ViewBag.Title = "Verify OTP";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-xxl">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner">

            <div class="card px-sm-6 px-0">
                <div class="card-body">

                    <!-- Logo -->
                    <div class="app-brand justify-content-center mb-4">
                        <a href="@Url.Action("Index", "Dashboard")" class="app-brand-link gap-2">
                            <span class="app-brand-text demo text-heading fw-bold">ExpenseWeb</span>
                        </a>
                    </div>

                    <!-- Title -->
                    <h4 class="mb-2 text-center">Verify your email 📧</h4>
                    <p class="text-center mb-4">
                        Enter OTP sent to <strong>@Model.Email</strong>
                    </p>

                    <!-- MESSAGE -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger text-center">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <!-- VERIFY FORM -->
                    <form asp-action="VerifyOtp" method="post" id="verifyForm">
                        <input type="hidden" name="Email" value="@Model.Email" />
                        <input type="hidden" name="Otp" id="otpHidden" />

                        <div class="mb-4 text-center">
                            <label class="form-label mb-3">OTP Code</label>

                            <div class="d-flex justify-content-center gap-2">
                                @for (int i = 0; i < 6; i++)
                                {
                                    <input type="text"
                                           maxlength="1"
                                           class="form-control text-center otp-input"
                                           style="width:50px; height:50px; font-size:20px;" />
                                }
                            </div>
                        </div>

                        <button class="btn btn-primary d-grid w-100" type="submit">
                            Verify Account
                        </button>
                    </form>

                    <!-- RESEND -->
                    <form asp-action="ResendOtp" method="post" class="mt-3">
                        <input type="hidden" name="email" value="@Model.Email" />

                        <button id="resendBtn"
                                class="btn btn-outline-secondary w-100"
                                type="submit">
                            Resend OTP
                        </button>
                    </form>

                    <p id="countdownText" class="text-center mt-2 text-muted"></p>

                    <!-- BACK -->
                    <p class="text-center mt-4">
                        <a href="@Url.Action("Login", "Auth")">
                            Back to login
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const inputs = document.querySelectorAll(".otp-input");
        const hiddenInput = document.getElementById("otpHidden");
        const form = document.getElementById("verifyForm");

        // ===== OTP INPUT =====
        inputs.forEach((input, index) => {

            input.addEventListener("input", (e) => {
                const value = e.target.value;

                if (!/^\d$/.test(value)) {
                    e.target.value = "";
                    return;
                }

                if (index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }

                updateOtp();
            });

            input.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !input.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });

            input.addEventListener("focus", () => input.select());
        });

        function updateOtp() {
            let otp = "";
            inputs.forEach(i => otp += i.value);
            hiddenInput.value = otp;

            if (otp.length === 6) {
                setTimeout(() => form.submit(), 300);
            }
        }

        // ===== PASTE OTP =====
        inputs[0].addEventListener("paste", (e) => {
            const paste = e.clipboardData.getData("text").trim();

            if (/^\d{6}$/.test(paste)) {
                inputs.forEach((input, i) => input.value = paste[i]);
                updateOtp();
            }

            e.preventDefault();
        });

        // ===== COUNTDOWN =====
        const resendBtn = document.getElementById("resendBtn");
        const countdownText = document.getElementById("countdownText");

        let time = 60;

        function startCountdown() {
            const interval = setInterval(() => {
                if (time > 0) {
                    resendBtn.disabled = true;
                    resendBtn.innerText = `Resend (${time}s)`;
                    countdownText.innerText = `You can resend OTP in ${time}s`;
                    time--;
                } else {
                    resendBtn.disabled = false;
                    resendBtn.innerText = "Resend OTP";
                    countdownText.innerText = "";
                    clearInterval(interval);
                }
            }, 1000);
        }

        resendBtn.addEventListener("click", () => {
            time = 60;
        });

        window.onload = () => {
            inputs[0].focus();
            startCountdown();
        };
    </script>
}