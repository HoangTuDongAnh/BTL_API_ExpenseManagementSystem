                    <option value="Mua Sắm">Mua Sắm</option>
                    <option value="Giải Trí">Giải Trí</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>
            <div class="form-group-custom">
                <label>Loại Thời Gian</label>
                <select id="editTimeType">
                    <option value="day">Theo ngày</option>
                    <option value="week">Theo tuần</option>
                    <option value="month">Theo tháng</option>
                    <option value="hour">Theo giờ</option>
                    <option value="custom">Tùy chọn</option>
                </select>
            </div>

            <div class="form-group-custom custom-date-group" style="display: none;">
                <label>Từ ngày</label>
                <input type="date" id="editStartDate">
            </div>
            <div class="form-group-custom custom-date-group" style="display: none;">
                <label>Đến ngày</label>
                <input type="date" id="editEndDate">
            </div>

            <div class="form-group-custom">
                <label>Ngân Sách Dự Kiến (VNĐ)</label>
                <input type="number" id="editBudget">
            </div>
            <div class="form-group-custom">
                <label>Số Tiền Đã Chi (VNĐ)</label>
                <input type="number" id="editSpent">
            </div>
            <div class="modal-actions">
                <button class="btn-delete" id="btnTriggerDelete">Xóa</button>
                <button class="btn-submit" id="btnUpdate">Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteConfirmModal" style="z-index: 10005;">
    <div class="modal-content-custom" style="width: 380px; text-align: center; padding: 30px;">
        <div style="font-size: 50px; color: var(--danger); margin-bottom: 15px;"><i class="bx bx-error-circle"></i></div>
        <h2 style="margin-bottom: 10px; font-size: 20px; color: var(--text-main);">Xóa hạn mức này?</h2>
        <p style="color: var(--text-muted); margin-bottom: 25px; font-size: 14px;">Dữ liệu về hạn mức chi tiêu này sẽ bị mất vĩnh viễn.</p>
        <div class="modal-actions" style="margin-top: 0;">
            <button class="btn-cancel" onclick="closeModal('deleteConfirmModal')">Hủy bỏ</button>
            <button class="btn-confirm-danger" id="btnConfirmDelete">Vâng, Xóa nó!</button>
        </div>
    </div>
</div>

<div class="toast-custom" id="toastNotification">
    <i class="bx bx-check-circle" style="font-size: 20px;"></i>
    <span id="toastMessage">Thành công!</span>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <script>
        // --- 1. TIỆN ÍCH ---
        const formatVND = (amount) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        document.getElementById('current-date').innerText = new Date().toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        function showToast(message, isError = false) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastMessage').innerText = message;
            toast.style.backgroundColor = isError ? 'var(--danger)' : 'var(--success)';
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('show');
        }

        const typeLabels = { 'day': 'Ngày', 'week': 'Tuần', 'month': 'Tháng', 'hour': 'Giờ', 'custom': 'Tùy chọn' };

        // --- 2. DỮ LIỆU ---
        let budgets = [
            { id: 1, category: 'Nhà Ở', timeType: 'day', spent: 100000, budget: 100000 },
            { id: 2, category: 'Ăn Uống', timeType: 'month', spent: 500000, budget: 1000000 },
            { id: 3, category: 'Đi Lại', timeType: 'week', spent: 50000, budget: 2000000 },
            { id: 4, category: 'Mua Sắm', timeType: 'week', spent: 10000, budget: 20000 },
            { id: 5, category: 'Giải Trí', timeType: 'hour', spent: 10, budget: 100 },
            { id: 6, category: 'Khác', timeType: 'custom', startDate: '2026-04-15', endDate: '2026-04-20', spent: 0, budget: 50000 }
        ];

        let calendarInstance = null;

        // --- 3. LỊCH FULLCALENDAR (Fetch Động & Chuẩn UI) ---
        function initCalendar() {
            const calendarEl = document.getElementById('calendar');
            calendarInstance = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'vi',
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek' },
                buttonText: { today: 'Hôm nay', month: 'Tháng', week: 'Tuần' },
                allDayText: 'Cả ngày',
                events: fetchCalendarEvents
            });
            calendarInstance.render();
        }

        function fetchCalendarEvents(info, successCallback, failureCallback) {
            let events = [];

            // Xử lý lệch múi giờ (UTC Bug)
            const toLocalISO = (date) => {
                const d = new Date(date);
                d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                return d.toISOString().split('T')[0];
            };

            const todayStr = toLocalISO(new Date());

            budgets.forEach(b => {
                if (b.timeType === 'month') {
                    // Đánh dấu mùng 1 hàng tháng kèm Icon
                    let currentMonth = new Date(info.start.getFullYear(), info.start.getMonth(), 1);
                    while (currentMonth <= info.end) {
                        events.push({
                            title: `⭐ ${b.category}`,
                            start: toLocalISO(currentMonth),
                            allDay: true,
                            className: 'event-monthly'
                        });
                        currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
                    }
                }
                else if (b.timeType === 'week') {
                    // Đánh dấu mỗi Thứ 2 kèm Icon
                    events.push({
                        title: `🔄 ${b.category}`,
                        daysOfWeek: [1],
                        allDay: true,
                        className: 'event-weekly'
                    });
                }
                else if (b.timeType === 'day') {
                    events.push({
                        title: `⚡ ${b.category}`,
                        start: todayStr,
                        allDay: true,
                        className: 'event-daily'
                    });
                }
                else if (b.timeType === 'hour') {
                    events.push({
                        title: `⏳ ${b.category}`,
                        start: new Date().toISOString(),
                        allDay: false,
                        className: 'event-hourly'
                    });
                }
                else if (b.timeType === 'custom' && b.startDate && b.endDate) {
                    // Kéo dài thanh ngang từ Start -> End
                    let endObj = new Date(b.endDate);
                    endObj.setDate(endObj.getDate() + 1);
                    events.push({
                        title: `🎯 ${b.category}`,
                        start: b.startDate,
                        end: toLocalISO(endObj),
                        allDay: true,
                        className: 'event-custom'
                    });
                }
            });

            successCallback(events);
        }

        // --- 4. HÀM CẬP NHẬT GIAO DIỆN ---
        function updateDashboard() {
            renderBudgets();
            updateSummaryCards();
            if(calendarInstance) {
                calendarInstance.refetchEvents();
            }
        }

        function updateSummaryCards() {
            let totalBudget = 0, totalSpent = 0;
            budgets.forEach(cat => { totalBudget += cat.budget; totalSpent += cat.spent; });
            const remaining = totalBudget - totalSpent;
            const percent = totalBudget === 0 ? 0 : (totalSpent / totalBudget) * 100;

            document.getElementById('sum-budget').innerText = formatVND(totalBudget);
            document.getElementById('sum-spent').innerText = formatVND(totalSpent);

            const remainCard = document.getElementById('sum-remaining');
            const statusCard = document.getElementById('sum-status');

            if (remaining < 0) {
                remainCard.innerText = formatVND(remaining);
                remainCard.style.color = 'var(--danger)';
                statusCard.className = 'status red';
                statusCard.innerHTML = `<i class="bx bx-error"></i> Vượt tổng ngân sách!`;
            } else {
                remainCard.innerText = formatVND(remaining);
                remainCard.style.color = 'var(--success)';
                statusCard.className = 'status green';
                statusCard.innerHTML = `<i class="bx bx-check-circle"></i> An toàn (${percent.toFixed(0)}% đã dùng)`;
            }
        }

        function renderBudgets() {
            const container = document.getElementById('categories-list');
            container.innerHTML = '';

            budgets.forEach(cat => {
                const percentage = cat.budget === 0 ? 0 : (cat.spent / cat.budget) * 100;
                const remaining = cat.budget - cat.spent;
                let barColor, statusText, statusColor;

                if (percentage > 100) {
                    barColor = 'var(--danger)'; statusColor = 'var(--danger)'; statusText = `Vượt mức ${formatVND(Math.abs(remaining))}`;
                } else if (percentage === 100) {
                    barColor = 'var(--danger)'; statusColor = 'var(--danger)'; statusText = `Đã hết ngân sách`;
                } else if (percentage >= 90) {
                    barColor = 'var(--warning)'; statusColor = 'var(--warning)'; statusText = `Còn ${formatVND(remaining)}`;
                } else {
                    barColor = 'var(--primary-color)'; statusColor = 'var(--success)'; statusText = `Còn ${formatVND(remaining)}`;
                }

                const barWidth = percentage > 100 ? 100 : percentage;

                const html = `
                    <div class="category-item" onclick="openEditModal(${cat.id})">
                        <div class="cat-info">
                            <div>
                                <span class="cat-name">${cat.category}</span>
                                <span class="cat-type-badge">${typeLabels[cat.timeType]}</span>
                            </div>
                            <span class="cat-spent">${formatVND(cat.spent)} / ${formatVND(cat.budget)}</span>
                        </div>
                        <div class="progress-track"><div class="progress-fill" style="width: ${barWidth}%; background-color: ${barColor};"></div></div>
                        <div class="cat-footer">
                            <span style="color: ${barColor}; font-weight: bold;">${percentage.toFixed(1)}%</span>
                            <span style="color: ${statusColor};">${statusText}</span>
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
        }

        // --- 5. LOGIC ẨN/HIỆN NGÀY VÀ XỬ LÝ MODAL ---
        function toggleCustomDateFields(modalId, timeType) {
            const displayStyle = timeType === 'custom' ? 'block' : 'none';
            document.querySelectorAll(`#${modalId} .custom-date-group`).forEach(el => el.style.display = displayStyle);
        }

        document.getElementById('addTimeType').addEventListener('change', (e) => toggleCustomDateFields('addModal', e.target.value));
        document.getElementById('editTimeType').addEventListener('change', (e) => toggleCustomDateFields('editModal', e.target.value));

        // Nút Thêm mới HM
        document.getElementById('openAddModalBtn').addEventListener('click', () => {
            document.getElementById('addModal').classList.add('show');
            toggleCustomDateFields('addModal', document.getElementById('addTimeType').value);
        });

        // Nút Lưu HM Mới
        document.getElementById('btnSaveNew').addEventListener('click', () => {
            const category = document.getElementById('addCategory').value;
            const timeType = document.getElementById('addTimeType').value;
            const budget = parseFloat(document.getElementById('addBudget').value);
            const spent = parseFloat(document.getElementById('addSpent').value) || 0;
            const startDate = document.getElementById('addStartDate').value;
            const endDate = document.getElementById('addEndDate').value;

            if (isNaN(budget) || budget <= 0) { alert('Vui lòng nhập Ngân sách hợp lệ!'); return; }
            if (timeType === 'custom' && (!startDate || !endDate)) { alert('Vui lòng chọn Từ ngày và Đến ngày!'); return; }

            const newId = budgets.length > 0 ? Math.max(...budgets.map(c => c.id)) + 1 : 1;
            budgets.push({ id: newId, category, timeType, budget, spent, startDate, endDate });

            updateDashboard();
            closeModal('addModal');

            // Reset form
            document.getElementById('addBudget').value = '';
            document.getElementById('addSpent').value = '0';
            document.getElementById('addStartDate').value = '';
            document.getElementById('addEndDate').value = '';

            showToast('Đã thêm hạn mức mới!');
        });

        // Mở Modal Sửa
        function openEditModal(id) {
            const b = budgets.find(c => c.id === id);
            if (!b) return;

            document.getElementById('editId').value = b.id;
            document.getElementById('editCategory').value = b.category;
            document.getElementById('editTimeType').value = b.timeType;
            document.getElementById('editBudget').value = b.budget;
            document.getElementById('editSpent').value = b.spent;

            if (b.timeType === 'custom') {
                document.getElementById('editStartDate').value = b.startDate || '';
                document.getElementById('editEndDate').value = b.endDate || '';
            }
            toggleCustomDateFields('editModal', b.timeType);

            document.getElementById('editModal').classList.add('show');
        }

        // Cập nhật HM đang sửa
        document.getElementById('btnUpdate').addEventListener('click', () => {
            const id = parseInt(document.getElementById('editId').value);
            const category = document.getElementById('editCategory').value;
            const timeType = document.getElementById('editTimeType').value;
            const budget = parseFloat(document.getElementById('editBudget').value);
            const spent = parseFloat(document.getElementById('editSpent').value) || 0;
            const startDate = document.getElementById('editStartDate').value;
            const endDate = document.getElementById('editEndDate').value;

            if (isNaN(budget) || budget <= 0) { alert('Ngân sách không hợp lệ!'); return; }
            if (timeType === 'custom' && (!startDate || !endDate)) { alert('Vui lòng chọn Từ ngày và Đến ngày!'); return; }

            const index = budgets.findIndex(c => c.id === id);
            if (index !== -1) {
                budgets[index] = { id, category, timeType, budget, spent, startDate, endDate };
                updateDashboard();
                closeModal('editModal');
                showToast('Cập nhật thành công!');
            }
        });

        // Xóa
        document.getElementById('btnTriggerDelete').addEventListener('click', () => { document.getElementById('deleteConfirmModal').classList.add('show'); });

        document.getElementById('btnConfirmDelete').addEventListener('click', () => {
            const id = parseInt(document.getElementById('editId').value);
            budgets = budgets.filter(c => c.id !== id);
            updateDashboard();
            closeModal('deleteConfirmModal');
            closeModal('editModal');
            showToast('Đã xóa hạn mức!', true);
        });

        // Đóng modal khi bấm ra ngoài
        window.onclick = function(event) {
            if (event.target.className.includes('modal-overlay')) {
                event.target.classList.remove('show');
            }
        }

        // Khởi chạy khi tải trang
        document.addEventListener('DOMContentLoaded', () => {
            initCalendar();
            updateDashboard();
        });
    </script>
}