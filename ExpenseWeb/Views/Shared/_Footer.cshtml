@{
    var lang = (ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;
}

<footer class="content-footer footer bg-footer-theme">
    <div class="container-xxl">
        <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
            <div class="mb-2 mb-md-0">
                © @DateTime.Now.Year <strong>ExpenseWeb</strong> -
                @T("Hệ thống quản lý chi tiêu cá nhân", "Personal Expense Management System")
            </div>

            <div class="text-body-secondary small">
                @T("Theo dõi ví, giao dịch và hạn mức chi tiêu.", "Track wallets, transactions and budget limits.")
            </div>
        </div>
    </div>
</footer>