@model ExpenseWeb.Models.ViewModels.Profile.ProfilePageViewModel
@using System.Linq
@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;

    ViewData["Title"] = T("Hồ sơ cá nhân", "My Profile");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var avatarUrl = string.IsNullOrWhiteSpace(Model?.Avatar)
        ? Url.Content("~/sneat/img/avatars/default/teams_1.png")
        : Model.Avatar;
    var defaultAvatars = ViewBag.DefaultAvatars as List<string> ?? new List<string>();
    var avatarLibrary = defaultAvatars.Take(9).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/page.profile.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Quản lý tài khoản", "Account management")</span>
            <h1 class="dashboard-hero-title">@T("Hồ sơ cá nhân", "My profile")</h1>
            <p class="dashboard-hero-text">
                @T("Cập nhật tên, ảnh đại diện và các thông tin cơ bản trong một khu vực gọn gàng để việc quản lý tài khoản thuận tiện hơn.", "Update your name, avatar, and basic information in one tidy place for easier account management.")
            </p>
        </div>
    </section>

    <div class="card profile-shell-card mb-4">
        <div class="profile-shell-header">
            <div class="profile-shell-title">
                <div class="profile-title-icon"><i class="bx bx-user-circle"></i></div>
                <div>
                    <h2 class="profile-title-heading">@T("Thông tin cơ bản", "Basic information")</h2>
                    <p class="profile-title-desc">@T("Cập nhật họ tên, số điện thoại và ảnh đại diện của bạn.", "Update your full name, phone number, and avatar.")</p>
                </div>
            </div>
        </div>

        <div class="profile-panel">
            <div class="profile-grid">
                <div class="profile-avatar-card">
                    <div class="profile-avatar-stage" title="@T("Click để xem ảnh phóng to", "Click to zoom in")" data-bs-toggle="modal" data-bs-target="#viewAvatarModal">
                        <img src="@avatarUrl" alt="user-avatar" class="profile-avatar-img" id="uploadedAvatar" />
                    </div>

                    <div class="profile-avatar-note">
                        @T("Bạn có thể tải ảnh từ máy hoặc chọn nhanh một ảnh mặc định trong thư viện bên dưới.", "Upload a photo from your device or quickly choose a default avatar from the library below.")
                    </div>

                    <div class="profile-avatar-actions">
                        <input type="file" id="uploadAvatarFile" name="AvatarFile" accept="image/*" hidden />
                        <button type="button" class="btn btn-primary w-100" onclick="document.getElementById('uploadAvatarFile').click()">
                            <i class="bx bx-upload me-2"></i>@T("Upload ảnh", "Upload image")
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#defaultAvatarModal">
                            <i class="bx bx-image me-2"></i>@T("Dùng ảnh mặc định", "Use default avatar")
                        </button>
                    </div>
                </div>

                <div class="profile-info-card">
                    <form id="formProfileSettings" method="post" enctype="multipart/form-data" onsubmit="return false">
                        <input type="hidden" id="avatarUrl" name="Avatar" value="@Model.Avatar" />

                        <div class="profile-form-grid">
                            <div>
                                <label for="lastName" class="form-label">@T("Họ và tên đệm", "Last name")</label>
                                <input class="form-control profile-input" type="text" name="lastName" id="lastName" value="@Model.LastName" placeholder="@T("Nguyễn Văn", "Nguyen Van")" />
                            </div>

                            <div>
                                <label for="firstName" class="form-label">@T("Tên", "First name")</label>
                                <input class="form-control profile-input" type="text" id="firstName" name="firstName" value="@Model.FirstName" autofocus placeholder="@T("A", "A")" />
                            </div>

                            <div>
                                <label for="email" class="form-label">E-mail</label>
                                <input class="form-control profile-input profile-input-readonly" type="email" id="email" name="email" value="@Model.Email" readonly title="@T("Email không thể thay đổi", "Email cannot be changed")" />
                            </div>

                            <div>
                                <label class="form-label" for="phoneNumber">@T("Số điện thoại", "Phone number")</label>
                                <div class="input-group profile-input-group">
                                    <span class="input-group-text">VN (+84)</span>
                                    <input type="text" id="phoneNumber" name="phoneNumber" class="form-control profile-input" value="@Model.PhoneNumber" placeholder="09xx xxx xxx" />
                                </div>
                            </div>
                        </div>

                        <div class="profile-actions">
                            <button type="button" class="btn btn-outline-secondary" id="btnResetProfile">@T("Khôi phục", "Reset")</button>
                            <button type="submit" class="btn btn-primary" id="btnSaveProfile">
                                <i class="bx bx-save me-1"></i>@T("Lưu thay đổi", "Save changes")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="danger-card">
        <div class="danger-header">
            <div class="danger-title">
                <div class="danger-icon"><i class="bx bx-error-circle"></i></div>
                <div>
                    <h3>@T("Khu vực nguy hiểm", "Danger zone")</h3>
                    <p class="mb-0">@T("Hành động này không thể hoàn tác. Dữ liệu của bạn sẽ bị xóa vĩnh viễn.", "This action cannot be undone. Your data will be deleted permanently.")</p>
                </div>
            </div>
        </div>
        <div class="danger-body">
            <div>
                <h6 class="mb-1 fw-bold">@T("Xóa tài khoản", "Delete account")</h6>
                <p class="mb-0 text-muted">
                    @T("Sau khi tài khoản của bạn bị xóa, tất cả dữ liệu giao dịch, ví và thiết lập sẽ không thể khôi phục.", "After deleting your account, all transaction, wallet, and settings data will be permanently removed.")
                </p>
            </div>
            <button type="button" class="btn btn-danger text-nowrap" id="btnDeleteAccount">
                <i class="bx bx-trash me-2"></i>@T("Xóa tài khoản", "Delete account")
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="viewAvatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-body text-center p-0 position-relative d-flex justify-content-center">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 mt-3 me-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 10;"></button>
                <img src="@avatarUrl" id="zoomedAvatar" class="img-fluid rounded-circle shadow-lg" style="width: 350px; aspect-ratio: 1/1; object-fit: cover; border: 5px solid #fff;" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade profile-avatar-picker" id="defaultAvatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">@T("Chọn ảnh đại diện mặc định", "Choose default avatar")</h5>
                    <p class="modal-subtitle">@T("Thư viện hiển thị theo dạng 3x3 để đồng bộ với các popup khác trong hệ thống.", "The library is displayed in a 3x3 layout to stay consistent with the other popups in the system.")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (avatarLibrary.Any())
                {
                    <div class="avatar-picker-grid">
                        @for (var i = 0; i < avatarLibrary.Count; i++)
                        {
                            var defaultUrl = avatarLibrary[i];
                            <div class="avatar-picker-card">
                                <img src="@defaultUrl" class="default-avatar-option avatar-picker-item" data-url="@defaultUrl" alt="avatar-@(i + 1)" />
                                <div class="avatar-picker-label">@T("Mẫu", "Avatar") @(i + 1)</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">@T("Chưa có ảnh mặc định trong hệ thống.", "No default avatars available.")</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/profile-page.js?v=@DateTime.Now.Ticks"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const uploadedAvatar = document.getElementById('uploadedAvatar');
            const zoomedAvatar = document.getElementById('zoomedAvatar');
            const uploadAvatarFile = document.getElementById('uploadAvatarFile');
            const hiddenAvatarInput = document.getElementById('avatarUrl');
            const pickerCards = document.querySelectorAll('.avatar-picker-card');

            uploadAvatarFile.addEventListener('change', function (e) {
                if (e.target.files && e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        uploadedAvatar.src = event.target.result;
                        zoomedAvatar.src = event.target.result;
                        hiddenAvatarInput.value = '';
                        pickerCards.forEach(card => card.classList.remove('active'));
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });

            const defaultOptions = document.querySelectorAll('.default-avatar-option');
            defaultOptions.forEach(option => {
                option.addEventListener('click', function () {
                    const selectedUrl = this.getAttribute('data-url');

                    uploadedAvatar.src = selectedUrl;
                    zoomedAvatar.src = selectedUrl;
                    hiddenAvatarInput.value = selectedUrl;
                    uploadAvatarFile.value = '';

                    pickerCards.forEach(card => card.classList.remove('active'));
                    this.closest('.avatar-picker-card')?.classList.add('active');

                    const modalEl = document.getElementById('defaultAvatarModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                });
            });
        });
    </script>
}
