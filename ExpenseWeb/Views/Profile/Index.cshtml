                                @T("Sau khi tài khoản của bạn bị xóa, tất cả dữ liệu giao dịch, ví và thiết lập sẽ không thể khôi phục.", "Once your account is deleted, all transaction data, wallets, and settings cannot be recovered.")
                            </p>
                        </div>
                        <button type="button" class="btn btn-danger text-nowrap" id="btnDeleteAccount">
                            <i class="bx bx-trash me-2"></i>@T("Xóa tài khoản", "Delete Account")
                        </button>
                    </div>
