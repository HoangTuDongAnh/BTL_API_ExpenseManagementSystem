@model ExpenseWeb.Models.ViewModels.Profile.SupportPageViewModel
@{
    ViewData["Title"] = "Hỗ trợ & Liên hệ admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-md-12">
            <div class="nav-align-top mb-4">
                <ul class="nav nav-pills flex-column flex-md-row mb-0 gap-md-0 gap-2">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Profile")">
                            <i class="icon-base bx bx-user icon-sm me-1_5"></i>
                            <span>Hồ sơ</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Support", "Profile")">
                            <i class="icon-base bx bx-help-circle icon-sm me-1_5"></i>
                            <span>Hỗ trợ</span>
                        </a>
                    </li>
                </ul>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card mb-4">
                        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <h5 class="mb-1"><i class="bx bx-support me-2 text-primary"></i>Gửi hỗ trợ đến admin</h5>
                                <p class="mb-0 text-muted">Form này map tới endpoint POST /support-requests.</p>
                            </div>
                            <span class="badge bg-label-primary">Đã nối ViewModel</span>
                        </div>
                        <div class="card-body">
                            <form asp-action="Support" asp-controller="Profile" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label asp-for="Form.SupportType" class="form-label">Loại hỗ trợ</label>
                                        <select asp-for="Form.SupportType" class="form-select">
                                            <option value="bug">Báo lỗi hệ thống</option>
                                            <option value="transaction">Hỗ trợ giao dịch</option>
                                            <option value="account">Hỗ trợ tài khoản</option>
                                            <option value="feature">Góp ý tính năng</option>
                                            <option value="other">Khác</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Form.Priority" class="form-label">Mức độ ưu tiên</label>
                                        <select asp-for="Form.Priority" class="form-select">
                                            <option value="low">Thấp</option>
                                            <option value="medium">Trung bình</option>
                                            <option value="high">Cao</option>
                                            <option value="urgent">Khẩn cấp</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Form.Subject" class="form-label">Tiêu đề</label>
                                        <input asp-for="Form.Subject" class="form-control" placeholder="Ví dụ: Không thể lưu giao dịch chi tiêu trong ví MB Bank" />
                                        <span asp-validation-for="Form.Subject" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Form.Message" class="form-label">Nội dung hỗ trợ</label>
                                        <textarea asp-for="Form.Message" class="form-control" rows="6" placeholder="Mô tả chi tiết vấn đề bạn gặp phải..."></textarea>
                                        <span asp-validation-for="Form.Message" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Form.Files" class="form-label">Tệp đính kèm</label>
                                        <input asp-for="Form.Files" type="file" multiple class="form-control" accept="image/*,video/*" />
                                        <div class="form-text">Hiện patch này mới nối luồng form và endpoint support. Nếu muốn upload file thật, cần bổ sung upload API riêng.</div>
                                    </div>
                                    <div class="col-12 d-flex justify-content-end gap-2">
                                        <button type="reset" class="btn btn-outline-secondary">Làm mới</button>
                                        <button type="submit" class="btn btn-primary"><i class="bx bx-send me-1"></i> Gửi hỗ trợ</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-1"><i class="bx bx-history me-2 text-info"></i>Lịch sử hỗ trợ gần đây</h5>
                            <p class="mb-0 text-muted">Danh sách này map tới GET /support-requests/my.</p>
                        </div>
                        <div class="card-body">
                            @if (Model.HistoryItems.Count == 0)
                            {
                                <div class="text-muted">Chưa có yêu cầu hỗ trợ nào.</div>
                            }
                            else
                            {
                                foreach (var item in Model.HistoryItems)
                                {
                                    <div class="border rounded-3 p-3 mb-3">
                                        <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-2">
                                            <div>
                                                <h6 class="mb-1">@item.Subject</h6>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge @item.StatusBadgeClass">@item.StatusLabel</span>
                                                    <span class="badge bg-label-info">@item.SupportTypeLabel</span>
                                                    <span class="badge bg-label-secondary">@item.SupportRequestId</span>
                                                </div>
                                            </div>
                                            <small class="text-muted">@item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                                        </div>
                                        <div class="text-muted small">Ưu tiên: @item.PriorityLabel</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-1"><i class="bx bx-transfer-alt me-2 text-warning"></i>Mapping đang dùng</h5>
                        </div>
                        <div class="card-body">
                            <ul class="mb-0 ps-3">
                                <li>`Form.SupportType` -> `support_type`</li>
                                <li>`Form.Priority` -> `priority`</li>
                                <li>`Form.Subject` -> `subject`</li>
                                <li>`Form.Message` -> `message`</li>
                                <li>Lịch sử support -> `SupportHistoryItemViewModel`</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
