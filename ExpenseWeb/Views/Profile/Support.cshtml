            <div class="card report-filter-card page-shell-card support-form-card">
                <div class="card-header border-bottom pb-3">
                    <h2 class="dashboard-section-title mb-1"><i class="bx bx-support me-2 text-primary"></i>@T("Gửi hỗ trợ đến admin", "Send Support Request")</h2>
                    <p class="dashboard-section-text mb-0">@T("Vui lòng điền chi tiết thông tin để chúng tôi có thể hỗ trợ bạn tốt nhất.", "Please provide detailed information so we can assist you better.")</p>
                </div>
                <div class="card-body pt-4">
                    <form asp-action="Support" asp-controller="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Form.SupportType" class="form-label">@T("Loại hỗ trợ", "Support Type")</label>
                                <select asp-for="Form.SupportType" class="form-select">
                                    <option value="bug">@T("Báo lỗi hệ thống", "System Bug")</option>
                                    <option value="transaction">@T("Hỗ trợ giao dịch", "Transaction Support")</option>
                                    <option value="account">@T("Hỗ trợ tài khoản", "Account Support")</option>
                                    <option value="feature">@T("Góp ý tính năng", "Feature Request")</option>
                                    <option value="other">@T("Khác", "Other")</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.Priority" class="form-label">@T("Mức độ ưu tiên", "Priority")</label>
                                <select asp-for="Form.Priority" class="form-select">
                                    <option value="low">@T("Thấp", "Low")</option>
                                    <option value="medium">@T("Trung bình", "Medium")</option>
                                    <option value="high">@T("Cao", "High")</option>
                                    <option value="urgent">@T("Khẩn cấp", "Urgent")</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Form.Subject" class="form-label">@T("Tiêu đề", "Subject")</label>
                                <input asp-for="Form.Subject" class="form-control" placeholder="@T("Ví dụ: Không thể lưu giao dịch...", "Example: Cannot save transaction...")" />
                                <span asp-validation-for="Form.Subject" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Form.Message" class="form-label">@T("Nội dung hỗ trợ", "Message Details")</label>
                                <textarea asp-for="Form.Message" class="form-control" rows="5" placeholder="@T("Mô tả chi tiết vấn đề bạn gặp phải...", "Describe your issue in detail...")"></textarea>
                                <span asp-validation-for="Form.Message" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Form.Files" class="form-label">@T("Tệp đính kèm (Tùy chọn)", "Attachments (Optional)")</label>
                                <input asp-for="Form.Files" type="file" multiple class="form-control" accept="image/*,video/*" />
                            </div>

                            <div class="col-12 pt-2 border-top d-flex justify-content-end gap-2 mt-4">
                                <button type="reset" class="btn btn-outline-secondary">@T("Làm mới", "Reset")</button>
                                <button type="submit" class="btn btn-primary"><i class="bx bx-send me-2"></i>@T("Gửi hỗ trợ", "Submit")</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card report-card page-shell-card support-history-card">
                <div class="card-header border-bottom pb-3">
                    <h3 class="report-title m-0"><i class="bx bx-history me-2 text-primary"></i>@T("Lịch sử gần đây", "Recent History")</h3>
                    <p class="report-text mt-1 mb-0">@T("Theo dõi trạng thái các yêu cầu hỗ trợ bạn đã gửi.", "Track the status of your submitted support requests.")</p>
                </div>
                <div class="card-body p-0">
                    @if (Model.HistoryItems.Count == 0)
                    {
                        <div class="report-empty p-4 text-center text-muted">@T("Chưa có yêu cầu hỗ trợ nào.", "No support requests found.")</div>
                    }
                    else
                    {
                        <div class="report-list">
                            <div class="report-list">
                                @foreach (var item in Model.HistoryItems)
                                {
                                    var collapseId = "collapseSupport_" + item.SupportRequestId;
                                    <div class="report-expense-item d-block px-4 py-3 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start" data-bs-toggle="collapse" href="#@collapseId" role="button" aria-expanded="false" aria-controls="@collapseId" style="cursor: pointer;" title="@T("Nhấn để xem chi tiết", "Click to view details")">
                                            <div class="w-100 pe-3">
                                                <div class="report-expense-name mb-1 fw-bold fs-6 text-primary hover-opacity">
                                                    @item.Subject <i class="bx bx-chevron-down ms-1 text-muted"></i>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                                                    <span class="badge @item.StatusBadgeClass">
                                                        @(lang == "en" ?
                                                                                                        item.Status == "pending" ? "Pending" :
                                                                                                        item.Status == "viewed" ? "Processing" :
                                                                                                        item.Status == "replied" ? "Replied" : "Closed"
                                                                                                        : item.StatusLabel)
                                                                                                                       </span>
                                                                                                                       <span class="badge bg-label-secondary">
                                                        @(lang == "en" ?
                                                                                                        item.SupportType == "bug" ? "System Bug" :
                                                                                                        item.SupportType == "transaction" ? "Transaction Support" :
                                                                                                        item.SupportType == "account" ? "Account Support" : "Feature Request"
                                                                                                        : item.SupportTypeLabel)
                                                                                                                            </span>
                                                                                                                            <span class="text-muted small ms-1">
                                                                                                                                <i class="bx bx-time-five me-1"></i>@item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                                                                                                            </span>
                                                                                                                        </div>
                                                                                                                    </div>
                                                                                                                    <div class="text-end flex-shrink-0">
                                                                                                                        <span class="badge bg-label-primary bg-opacity-10 text-primary border-0 mb-1">
                                                    @(lang == "en" ?
                                                                                                item.Priority == "low" ? "Low" :
                                                                                                item.Priority == "medium" ? "Medium" :
                                                                                                item.Priority == "high" ? "High" : "Urgent"
                                                                                                : item.PriorityLabel)
                                        </span>
                                        <div class="text-muted small mt-1">#@item.SupportRequestId</div>
                                    </div>
                                </div>

                                        <div class="collapse mt-3" id="@collapseId">
                                            <div class="p-3 bg-lighter rounded border">
                                                <div class="mb-3">
                                                    <span class="fw-semibold text-dark"><i class="bx bx-user me-1"></i>@T("Bạn đã gửi:", "You sent:")</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Message))
                                                    {
                                                        <p class="text-muted small mb-0 mt-2" style="white-space: pre-line; word-break: break-word;">@item.Message</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted small mb-0 mt-2 fst-italic">@T("(Chưa tải được nội dung từ API)", "(Failed to load content from API)")</p>
                                                    }
                                                </div>

                                                @if (item.Attachments != null && item.Attachments.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                                        @foreach (var attachment in item.Attachments)
                                                        {
                                                            <a href="@attachment.FileUrl" target="_blank" class="badge bg-label-secondary text-decoration-none">
                                                                <i class="bx bx-paperclip me-1"></i>@attachment.FileName
                                                            </a>
                                                        }
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(item.AdminReply))
                                                {
                                                    <div class="mt-2 p-3 bg-label-success rounded border-start border-3 border-success">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div class="d-flex align-items-center">
                                                                <i class="bx bx-support text-success fs-5 me-2"></i>
                                                                <span class="fw-bold text-success">@T("Admin phản hồi", "Admin Reply")</span>
                                                            </div>
                                                            @if (item.RepliedAt.HasValue)
                                                            {
                                                                <span class="text-success small">@item.RepliedAt.Value.ToString("HH:mm - dd/MM")</span>
                                                            }
                                                        </div>
                                                        <p class="mb-0 mt-2 text-dark small" style="white-space: pre-line; word-break: break-word;">@item.AdminReply</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}