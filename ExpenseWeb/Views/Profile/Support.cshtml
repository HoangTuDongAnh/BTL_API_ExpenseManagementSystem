@model ExpenseWeb.Models.ViewModels.Profile.SupportPageViewModel
@using System.Linq
@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;
    ViewData["Title"] = T("Hỗ trợ & Liên hệ admin", "Support & Contact Admin");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/css/pages/core-page-hero.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/page-shell.css" />
    <link rel="stylesheet" href="~/sneat/css/pages/support-page.css" />

    <style>
        .support-attachment-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 10px;
        }

        .support-attachment-card {
            width: 180px;
            border: 1px solid #d9dee3;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            background-color: #fff;
        }

        .support-attachment-preview,
        .support-attachment-video {
            width: 100%;
            height: 140px;
            object-fit: cover;
            display: block;
            border-bottom: 1px solid #d9dee3;
        }

        .support-attachment-body {
            padding: 10px;
            background-color: #f8f9fa;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .support-attachment-name {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 4px;
        }

        .support-attachment-meta {
            font-size: 0.75rem;
            color: #697a8d;
            margin-bottom: 8px;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <section class="dashboard-hero mb-4">
        <div class="dashboard-hero-copy hero-copy-single">
            <span class="dashboard-hero-eyebrow">@T("Liên hệ hệ thống", "System Contact")</span>
            <h1 class="dashboard-hero-title">@T("Gửi yêu cầu hỗ trợ, phản ánh và góp ý tại một nơi", "Send support requests, reports, and feedback in one place")</h1>
            <p class="dashboard-hero-text">
                @T("Khi cần trợ giúp hoặc muốn báo sự cố, bạn có thể gửi nội dung tại đây để đội ngũ quản trị tiếp nhận nhanh và theo dõi dễ hơn.", "Whenever you need help or want to report an issue, send it here so the admin team can review it quickly and track it more easily.")
            </p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible mb-4" role="alert">
            <i class="bx bx-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning alert-dismissible mb-4" role="alert">
            <i class="bx bx-error me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12">
            <div class="card support-shell-card">
                <div class="support-card-header">
                    <div class="support-card-title">
                        <div class="support-card-icon"><i class="bx bx-support"></i></div>
                        <div>
                            <h2 class="support-card-heading">@T("Gửi hỗ trợ đến admin", "Send support request")</h2>
                            <p class="support-card-desc">
                                @T("Điền đúng loại hỗ trợ, mức ưu tiên và mô tả đủ chi tiết để đội ngũ quản trị tiếp nhận nhanh hơn.", "Choose the right support type, priority, and provide enough detail so the admin team can process it faster.")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="support-form-panel">
                    <form asp-action="Support" asp-controller="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="support-form-grid">
                            <div>
                                <label asp-for="Form.SupportType" class="form-label">@T("Loại hỗ trợ", "Support Type")</label>
                                <select asp-for="Form.SupportType" class="form-select support-select">
                                    <option value="bug">@T("Báo lỗi hệ thống", "System Bug")</option>
                                    <option value="transaction">@T("Hỗ trợ giao dịch", "Transaction Support")</option>
                                    <option value="account">@T("Hỗ trợ tài khoản", "Account Support")</option>
                                    <option value="feature">@T("Góp ý tính năng", "Feature Request")</option>
                                    <option value="other">@T("Khác", "Other")</option>
                                </select>
                            </div>

                            <div>
                                <label asp-for="Form.Priority" class="form-label">@T("Mức độ ưu tiên", "Priority")</label>
                                <select asp-for="Form.Priority" class="form-select support-select">
                                    <option value="low">@T("Thấp", "Low")</option>
                                    <option value="medium">@T("Trung bình", "Medium")</option>
                                    <option value="high">@T("Cao", "High")</option>
                                    <option value="urgent">@T("Khẩn cấp", "Urgent")</option>
                                </select>
                            </div>

                            <div class="full-span">
                                <label asp-for="Form.Subject" class="form-label">@T("Tiêu đề", "Subject")</label>
                                <input asp-for="Form.Subject" class="form-control support-input" placeholder="@T("Ví dụ: Không thể lưu giao dịch chi tiêu", "Example: Cannot save expense transaction")" />
                                <span asp-validation-for="Form.Subject" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="full-span">
                                <label asp-for="Form.Message" class="form-label">@T("Nội dung hỗ trợ", "Message Details")</label>
                                <textarea asp-for="Form.Message" class="form-control support-textarea" placeholder="@T("Mô tả chi tiết vấn đề bạn gặp phải...", "Describe your issue in detail...")"></textarea>
                                <span asp-validation-for="Form.Message" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="full-span">
                                <label asp-for="Form.Files" class="form-label">@T("Tệp đính kèm (Tùy chọn)", "Attachments (Optional)")</label>
                                <div class="support-file-wrap">
                                    <input asp-for="Form.Files" type="file" multiple class="form-control support-file" accept="image/*,video/*" />
                                    <span asp-validation-for="Form.Files" class="text-danger small mt-1 d-block"></span>
                                    <div class="support-file-hint">
                                        @T("Hỗ trợ ảnh/video. Tối đa 5 tệp, mỗi tệp tối đa 20 MB.", "Support image/video. Maximum 5 files, each file up to 20 MB.")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="support-actions">
                            <button type="reset" class="btn btn-outline-secondary">@T("Làm mới", "Reset")</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-send me-2"></i>@T("Gửi hỗ trợ", "Submit")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card support-shell-card">
                <div class="support-card-header">
                    <div class="support-card-title">
                        <div class="support-card-icon"><i class="bx bx-history"></i></div>
                        <div>
                            <h3 class="support-card-heading" style="font-size: 1.5rem;">@T("Lịch sử gần đây", "Recent history")</h3>
                            <p class="support-card-desc">@T("Theo dõi trạng thái các yêu cầu hỗ trợ bạn đã gửi.", "Track the status of the support requests you have submitted.")</p>
                        </div>
                    </div>
                </div>

                <div class="support-history-wrap">
                    @if (Model.HistoryItems.Count == 0)
                    {
                        <div class="support-empty">@T("Chưa có yêu cầu hỗ trợ nào.", "No support requests found.")</div>
                    }
                    else
                    {
                        <div class="support-history-list">
                            @foreach (var item in Model.HistoryItems)
                            {
                                var collapseId = "collapseSupport_" + item.SupportRequestId;
                                var statusText = lang == "en"
                                ? item.Status == "pending" ? "Pending"
                                : item.Status == "viewed" ? "Processing"
                                : item.Status == "replied" ? "Replied"
                                : "Closed"
                                : item.StatusLabel;
                                var supportTypeText = lang == "en"
                                ? item.SupportType == "bug" ? "System Bug"
                                : item.SupportType == "transaction" ? "Transaction Support"
                                : item.SupportType == "account" ? "Account Support"
                                : item.SupportType == "feature" ? "Feature Request"
                                : "Other"
                                : item.SupportTypeLabel;
                                var priorityText = lang == "en"
                                ? item.Priority == "low" ? "Low"
                                : item.Priority == "medium" ? "Medium"
                                : item.Priority == "high" ? "High"
                                : "Urgent"
                                : item.PriorityLabel;
                                <div class="support-history-item">
                                    <div class="support-history-head" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" title="@T("Nhấn để xem chi tiết", "Click to view details")">
                                        <div class="flex-grow-1">
                                            <div class="support-history-title">
                                                <span>@item.Subject</span>
                                                <i class="bx bx-chevron-down text-muted"></i>
                                            </div>

                                            <div class="support-meta-row">
                                                <span class="badge @item.StatusBadgeClass">@statusText</span>
                                                <span class="support-chip">@supportTypeText</span>
                                                <span class="support-chip"><i class="bx bx-time-five"></i>@item.CreatedAt.ToString("HH:mm - dd-MM-yyyy")</span>
                                            </div>
                                        </div>

                                        <div class="text-end flex-shrink-0">
                                            <span class="support-chip support-priority-chip">@priorityText</span>
                                            <span class="support-request-code">#@item.SupportRequestId</span>
                                        </div>
                                    </div>

                                    <div class="collapse" id="@collapseId">
                                        <div class="support-history-body">
                                            <div class="support-body-panel">
                                                <div>
                                                    <div class="support-block-title">
                                                        <i class="bx bx-message-square-detail"></i>
                                                        <span>@T("Nội dung bạn đã gửi", "Message you sent")</span>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(item.Message))
                                                    {
                                                        <p class="support-message-text">@item.Message</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="support-message-text fst-italic">@T("(Chưa tải được nội dung từ API)", "(Failed to load content from API)")</p>
                                                    }
                                                </div>

                                                @if (item.Attachments != null && item.Attachments.Any())
                                                {
                                                    <div class="mt-4">
                                                        <div class="support-block-title">
                                                            <i class="bx bx-paperclip"></i>
                                                            <span>@T("Tệp đính kèm", "Attachments")</span>
                                                        </div>

                                                        <div class="support-attachment-grid">
                                                            @foreach (var attachment in item.Attachments)
                                                            {
                                                                <div class="support-attachment-card">
                                                                    @if (attachment.IsImage)
                                                                    {
                                                                        <img src="@attachment.FileUrl" alt="@attachment.FileName" class="support-attachment-preview view-media-btn" data-type="image" data-src="@attachment.FileUrl" style="cursor: pointer;" title="@T("Nhấn để xem lớn", "Click to view larger")" />
                                                                    }
                                                                    else if (attachment.IsVideo)
                                                                    {
                                                                        <div class="position-relative view-media-btn" data-type="video" data-src="@attachment.FileUrl" style="cursor: pointer;" title="@T("Nhấn để xem lớn", "Click to view larger")">
                                                                            <video class="support-attachment-video" preload="metadata" style="pointer-events: none;">
                                                                                <source src="@attachment.FileUrl" type="@attachment.FileType" />
                                                                            </video>
                                                                            <div class="position-absolute top-50 start-50 translate-middle text-white" style="background: rgba(0,0,0,0.4); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                                                <i class="bx bx-play ms-1 fs-3"></i>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="support-attachment-preview d-flex align-items-center justify-content-center">
                                                                            <i class="bx bx-file fs-1 text-muted"></i>
                                                                        </div>
                                                                    }

                                                                    <div class="support-attachment-body">
                                                                        <div class="support-attachment-name" title="@attachment.FileName">@attachment.FileName</div>
                                                                        <div class="support-attachment-meta">
                                                                            @if (!string.IsNullOrWhiteSpace(attachment.DisplaySize))
                                                                            {
                                                                                <span>@attachment.DisplaySize</span>
                                                                            }
                                                                        </div>

                                                                        @if (attachment.IsImage || attachment.IsVideo)
                                                                        {
                                                                            <a href="javascript:void(0);" class="small text-primary text-decoration-none view-media-btn" data-type="@(attachment.IsImage ? "image" : "video")" data-src="@attachment.FileUrl">
                                                                                @T("Mở xem", "View")
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="@attachment.FileUrl" target="_blank" class="small text-primary text-decoration-none">
                                                                                @T("Tải xuống", "Download")
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(item.AdminReply))
                                                {
                                                    <div class="support-admin-reply">
                                                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2 flex-wrap">
                                                            <div class="support-block-title mb-0 text-success">
                                                                <i class="bx bx-support"></i>
                                                                <span>@T("Phản hồi từ admin", "Reply from admin")</span>
                                                            </div>
                                                            @if (item.RepliedAt.HasValue)
                                                            {
                                                                <span class="small text-success">@item.RepliedAt.Value.ToString("HH:mm - dd/MM")</span>
                                                            }
                                                        </div>
                                                        <p class="support-message-text text-dark mb-0">@item.AdminReply</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mediaViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0" id="mediaViewerContent">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $(document).on('click', '.view-media-btn', function(e) {
                e.preventDefault();
                var type = $(this).data('type');
                var src = $(this).data('src');
                var $content = $('#mediaViewerContent');

                $content.empty();

                if (type === 'image') {
                    $content.html('<img src="' + src + '" class="rounded shadow" style="width: 100%; height: 80vh; object-fit: contain; background-color: rgba(0,0,0,0.2);" />');
                } else if (type === 'video') {
                    $content.html(`
                        <video controls autoplay class="rounded shadow" style="width: 100%; height: 80vh; object-fit: contain; background-color: rgba(0,0,0,0.2);">
                            <source src="${src}">
                            @T("Trình duyệt của bạn không hỗ trợ thẻ video.", "Your browser does not support the video tag.")
                        </video>
                    `);
                }

                $('#mediaViewerModal').modal('show');
            });

            $('#mediaViewerModal').on('hidden.bs.modal', function () {
                $('#mediaViewerContent').empty();
            });
        });
    </script>
}